PROC COMP_NFOOD2MOD
preproc 
ask if SAVESTATUS_NONFOODMOD =1;
if SAVESTATUS_NONFOODMOD =1 then 
COMP_NFOOD2MOD =1;
endif;
postproc
if COMP_NFOOD2MOD = 1 then 
file ModuleCompleteness; 
setfile(ModuleCompleteness,"../reports/CompleteModule/ModuleCompleteness.txt", update);
filewrite(ModuleCompleteness,"%5d,%3d,%2d,%2d,%1d,%1d",A0_MRCB,PSU,SSU,HH,MODULENO,COMP_NFOOD2MOD);	
saveIdsForLogin();
endif;
//savesetting("completeHCMOD",maketext("%v",COMPLETE_HCMOD));
