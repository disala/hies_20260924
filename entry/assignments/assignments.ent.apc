{Application 'ASSIGNMENTS' logic file generated by CSPro}
PROC GLOBAL

{HEADNAME = tonumber(sysparm("State"));     // sets STATE to 20 
ADD_LINE1 = tonumber(sysparm("County"));   // sets COUNTY to 5
ADD_LINE2 = tonumber(sysparm("State"));     // sets STATE to 20 
ADD_LINE3 = tonumber(sysparm("County"));   // sets COUNTY to 5
ADD_LINE4 = tonumber(sysparm("State"));     // sets STATE to 20 }

function saveIdsForLogin() 
	savesetting("SUPID",strip(ASSIGNMENTS_DICT.SUPID));
	savesetting("ENUID",strip(ASSIGNMENTS_DICT.ENUID));
	savesetting("A0_MRCB",ASSIGNMENTS_DICT.A0_MRCB);
	savesetting("PSU",ASSIGNMENTS_DICT.PSU);
	savesetting("SSU",ASSIGNMENTS_DICT.SSU);
	savesetting("HH",ASSIGNMENTS_DICT.HH);
	savesetting("endx",1);
end;	

function onstop()
savepartial();
saveIdsForLogin();
end;




function exitprogram()
	if accept(maketext(50),maketext(10),maketext(20))=1 then
		execpff("HIESCAPIENTRY.pff", stop);
endif;
end;

function backtomain()
	if accept(maketext(51),maketext(10),maketext(20))=1 then
		stop(1);
	endif;
end;


function showMenu()
	userbar(clear);
	//userbar(add Button,maketext(52),exitprogram());
	 //userbar(add Button,maketext(53),backtomain());
	userbar(show);
end;

function OnChangeLanguage()
    savesetting("curLanguage",getlanguage());
end;


PROC ASSIGNMENTS_FF
preproc 
string language=strip(loadsetting("curLanguage",""));
if language="" then 
	setlanguage("EN"); savesetting("curLanguage","EN");
else 
	setlanguage(language);
endif;
 showMenu()

PROC HH
{preproc 

string genuid;
numeric gmrcb,gpsu,gssu;

genuid = ENUID;
gmrcb = A0_MRCB;
gpsu = PSU;
gssu = SSU;
 forcase ASSIGNMENTS_DICT where ASSIGNMENTS_DICT.ENUID=genuid and ASSIGNMENTS_DICT.A0_MRCB=MENU_DICT.gmrcb  and   ASSIGNMENTS_DICT.PSU=gpsu and ASSIGNMENTS_DICT.SSU=gssu  do
	// Set some other metadata
	
	A1_DISTRICT = A1_DISTRICT;
	
	{dynamic_pff.setproperty("A1_DISTRICT",A1_DISTRICT);
	dynamic_pff.setproperty("A1_DISTRICTNAME",A1_DISTRICTNAME);
	dynamic_pff.setproperty("A2_DSDIVISION",A2_DSDIVISION);
	dynamic_pff.setproperty("A2_DSDIVISIONNAME",A2_DSDIVISIONNAME);
	dynamic_pff.setproperty("A3_GNDIVISION",A3_GNDIVISION);
	dynamic_pff.setproperty("A3_GNDIVISIONNAME",A3_GNDIVISIONNAME);
	dynamic_pff.setproperty("A4_SECTOR",A4_SECTOR);
	dynamic_pff.setproperty("HEADNAME",HEADNAME);
	dynamic_pff.setproperty("ADD_LINE1",ADD_LINE1);
	dynamic_pff.setproperty("ADD_LINE2",ADD_LINE2);
	dynamic_pff.setproperty("ADD_LINE3",ADD_LINE3);
	dynamic_pff.setproperty("ADD_LINE4",ADD_LINE4);
	
	//endfor;
	}
	endfor;}
PROC SAVESTATUS_NEWASSIGNMENT
if SAVESTATUS_NEWASSIGNMENT = 1 then
savepartial();  
errmsg(54,A0_MRCB,PSU,SSU,HH);
//backtoModuleMain();
else if 
$ = 2 then  
 savepartial();
 saveIdsForLogin();
 execpff("HIES2025.pff", stop);   
  endif; 
  endif; 

