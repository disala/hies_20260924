{function string GetCheckboxLabel()
string codes_to_check = "123";
string selected_labels;

do numeric ctr = 1 while ctr <= length(codes_to_check)

    if ischecked(codes_to_check[ctr:1], S9F) then
       
        if selected_labels <> "" then
            selected_labels = selected_labels + ", ";
        endif;

        selected_labels = selected_labels + getlabel(S9F, codes_to_check[ctr:1]);

    endif;
enddo;
  
end;


function string GetCheckboxLabel()
  
    string labels;
   
   // do numeric ctr = 1 while ctr <= length(strip(S9F)) // I1MULTI_VS1.codes.length()
   
   do numeric ctr = 1 while ctr <= S9F_VS1.codes.length()
        alpha(1) letter = S9F[ctr:1];
       
        if ischecked(letter, S9F) then
       
            // add a comma between each entry
            if labels <> "" then
              labels = labels + " , ";
            endif;
          
       labels = labels + getvaluelabel (S9F);
        endif;
       
    enddo;
   
    exit labels;
end;

function string GetCheckboxLabelforLivestock()
  
    string labels;
   
   // do numeric ctr = 1 while ctr <= length(strip(S9F)) // I1MULTI_VS1.codes.length()
   
   do numeric ctr = 1 while ctr <= S9B_VS1.codes.length()
        alpha(1) letter = S9B[ctr:1];
       
        if ischecked(letter, S9B) then
       
            // add a comma between each entry
            if labels <> "" then
              labels = labels + " , ";
            endif;
          
       labels = labels + getlabel (S9B, letter);
        endif;
       
    enddo;
   
    exit labels;
end;}


