PROC S92_LQTY
postproc

numeric noOfItem = length(strip(S9B))/4;

if curocc(SECTION_9_2_OWNED_LIVESTOCKS000) = noOfItem then
   endgroup;
endif;

PROC SAVESTATUS_HMOD
if SAVESTATUS_HMOD = 1 then 
savepartial();
errmsg(500,A0_MRCB,PSU,SSU,HH);
skip to COMP_HINFOMOD;
//backtoModuleMain();
else if SAVESTATUS_HMOD = 2 then 
	 savepartial();
	 saveIdsForLogin();
 //backtoModuleMain(); 
	 else
	  saveIdsForLogin();
  endif; 
  endif;

PROC COMP_HINFOMOD
preproc  
ask if SAVESTATUS_HMOD =1; 
if SAVESTATUS_HMOD =1 then  
COMP_HINFOMOD =1; 
endif;
postproc 
if COMP_HINFOMOD =1 then 
file ModuleCompleteness;  
setfile(ModuleCompleteness,"../reports/CompleteModule/ModuleCompleteness.txt", update); 
    filewrite(ModuleCompleteness,"%6d,%3d,%2d,%2d,%1d,%1d",A0_MRCB,PSU,SSU,HH,MODULENO,COMP_HINFOMOD); 
	saveIdsForLogin() 
		
endif; 
