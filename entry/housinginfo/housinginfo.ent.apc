PROC S71Q3_TIME
if S71Q3_TIME > 180 then
		  numeric ret=errmsg(75)
		  select(maketext(71), continue,
						maketext(76), S71Q3_TIME);
				if ret=1 then
					skip to S71CONTINUE;
					else 
					reenter;
	endif;
endif;

PROC S71Q2_DISTANCE
{if S71Q2_DISTANCE > 180 then
		  numeric ret=errmsg("The value you entered is Too high! confirm it")
		  select("Correct", continue,
						"Incorrect - Reenter ", S71Q3_TIME);
				if ret=1 then
					skip to S71CONTINUE;
					else 
					reenter;
	endif;
endif;}
PROC S71CONTINUE
preproc
$=1;
noinput;
PROC S91Q0

{if S91Q0 =2 then  // as instructed by mineka
  if S52A=1 or S53A=1 then 
		errmsg("If engage with agriculture activities, should have information for atleast one land");
  endif;
endif;}

if S91Q0=2 then
  skip to S9BQ1
endif;
PROC S9F
if length(strip(S9F)) < 1 then 
	errmsg(77);
	skip to SECTION_9_2_OWNED_LIVESTOCKS000;
endif;

  numeric currently_entered_rows = totocc(SEC_9_LAND_ANIMAL000);

    if currently_entered_rows = maxocc(SEC_9_LAND_ANIMAL000) then
        advance to SECTION_9_2_OWNED_LIVESTOCKS000;
    else
        advance to LANDCODE(currently_entered_rows + 1);
    endif;
	
{if length(strip(S9F)) < 1 then 
    errmsg(77);
    skip to SECTION_9_2_OWNED_LIVESTOCKS000;
endif;

// Save off the existing values from the roster into a hashmap
// so that we can maintain previosuly entered data
// when the rows are shifted due to insertions/deletions
hashmap oldValues;
do numeric i = 1 while i <= totocc(SEC_9_LAND_ANIMAL000)
    if visualvalue(LANDCODE(i)) <> notappl and visualvalue(S921A(i)) <> notappl then
        oldValues(visualvalue(LANDCODE(i))) = visualvalue(S921A(i));
    endif;
enddo;

numeric nextRow = 1;
// Update the roster to reflect the updated checkboxes.
// For each code that is checked in S9B, set S92_LCODE
// in the next row in the roster to have that code as
// well as the quantity that was entered for that code
// before if there was one.
do numeric i = 0 while i < length(strip(S9B))/4
    numeric code = tonumber(S9B[i * 4 + 1:4]);
    S92_LCODE(nextRow) = code;
    if oldValues.contains(code) then
        S92_LQTY(nextRow) = oldValues(code);
    else
        S92_LQTY(nextRow) = notappl;
    endif;
    nextRow = nextRow + 1;
enddo;

// Clear any extra rows due to removing a checkbox
// from S9B
do numeric i = nextRow while nextRow <= maxocc(SECTION_9_2_OWNED_LIVESTOCKS000)
    S92_LCODE(nextRow) = notappl;
    S92_LQTY(nextRow) = notappl;
    nextRow = nextRow + 1; 
enddo;

// If the user edits the checkboxes in S9B to add a new value,
// we want to go directly to the new value, instead of going to the
// value in the first row. To do this, we ddvance to the first row in
// the roster that should have a value for S92_LQTY but does not.
numeric i = 1;
while i <= maxocc(SECTION_9_2_OWNED_LIVESTOCKS000) do
    // If the checkbox in S9B is checked for the code corresponding to
    // row i, but S92_LQTY for in row i is empty, then advance to that field.
    if visualvalue(S92_LCODE(i)) <> notappl and
        visualvalue(S92_LQTY(i)) = notappl then
       
        // Must use advance here, not skip, otherwise we will lose the values
        // we already entered.
        advance to S92_LQTY(i);
    endif;
    i = i + 1;
enddo;}	


PROC LANDCODE
preproc
numeric stp1=1*(curocc()-1)+1;
string chs1=S9F[stp1:1];
LANDCODE=tonumber(chs1);
//noinput;
PROC S921P
if S921P = 0 then
	if S921R = 0 then
		if S921A = 0 then
		     errmsg(78);
			 reenter;
		endif;
	endif;
endif;
PROC S922P
postproc

{if S922P = 0 then
	if S922R = 0 then
		if S922A = 0 then
		     errmsg("Cultivated area cannot be zero");
			 reenter;
		endif;
	endif;
endif;} // mineka

numeric noOfItem = length(strip(S9F))/1;

if curocc(SEC_9_LAND_ANIMAL000) = noOfItem then
   endgroup;
endif;
PROC S9BQ1
if S9BQ1=2 then
  skip to SAVESTATUS_HMOD;
endif;
PROC S9B	
	if length(strip(S9B)) < 4 then 
    errmsg(79);
    skip to SAVESTATUS_HMOD;
endif;

// Save off the existing values from the roster into a hashmap
// so that we can maintain previosuly entered data
// when the rows are shifted due to insertions/deletions
hashmap oldValues;
do numeric i = 1 while i <= totocc(SECTION_9_2_OWNED_LIVESTOCKS000)
    if visualvalue(S92_LCODE(i)) <> notappl and visualvalue(S92_LQTY(i)) <> notappl then
        oldValues(visualvalue(S92_LCODE(i))) = visualvalue(S92_LQTY(i));
    endif;
enddo;

numeric nextRow = 1;
// Update the roster to reflect the updated checkboxes.
// For each code that is checked in S9B, set S92_LCODE
// in the next row in the roster to have that code as
// well as the quantity that was entered for that code
// before if there was one.
do numeric i = 0 while i < length(strip(S9B))/4
    numeric code = tonumber(S9B[i * 4 + 1:4]);
    S92_LCODE(nextRow) = code;
    if oldValues.contains(code) then
        S92_LQTY(nextRow) = oldValues(code);
    else
        S92_LQTY(nextRow) = notappl;
    endif;
    nextRow = nextRow + 1;
enddo;

// Clear any extra rows due to removing a checkbox
// from S9B
do numeric i = nextRow while nextRow <= maxocc(SECTION_9_2_OWNED_LIVESTOCKS000)
    S92_LCODE(nextRow) = notappl;
    S92_LQTY(nextRow) = notappl;
    nextRow = nextRow + 1; 
enddo;

// If the user edits the checkboxes in S9B to add a new value,
// we want to go directly to the new value, instead of going to the
// value in the first row. To do this, we ddvance to the first row in
// the roster that should have a value for S92_LQTY but does not.
numeric i = 1;
while i <= maxocc(SECTION_9_2_OWNED_LIVESTOCKS000) do
    // If the checkbox in S9B is checked for the code corresponding to
    // row i, but S92_LQTY for in row i is empty, then advance to that field.
    if visualvalue(S92_LCODE(i)) <> notappl and
        visualvalue(S92_LQTY(i)) = notappl then
       
        // Must use advance here, not skip, otherwise we will lose the values
        // we already entered.
        advance to S92_LQTY(i);
    endif;
    i = i + 1;
enddo;


