{Application 'HOUSINGINFO' logic file generated by CSPro}
PROC GLOBAL

function goto()
    
numeric section = accept(maketext(1),
                             maketext(2),
                             maketext(3),
							 maketext(4),
                             maketext(5),
							 maketext(6));								 
						
    if section = 1 then
	move to SEC_8_HOUSINGINFO advance;
    elseif section = 2 then
        move to  SECTION_6A advance;
    elseif section = 3 then
        move to  SECTION_6B_F advance;
	elseif section = 4 then
        move to  SECTION_7_1 advance;
	elseif section = 5 then
		move to  SECTION_9 advance;	
	 endif;	
end;



function sem (String mes, string color) // show err message
	userbar(clear);
	userbar(add Button,maketext(1005),goto());
	userbar(add button,"Check",do("AdvanceToEnd"));
	userbar(add text,mes);
	if toupper(color)="E" then // E - Erro
		userbar(set color,248,171,143);  
	else
		userbar(set color,190,224,160); 
	endif;
	userbar(show);
end;
function pass()
	sem("Pass","");
end;
{-- Edit Functions Start}

function saveIdsForLogin() 
	savesetting("MODULENO",HOUSINGINFODIC_DICT.MODULENO);
	savesetting("ENUID",strip(HOUSINGINFODIC_DICT.ENUID));
	savesetting("A0_MRCB",HOUSINGINFODIC_DICT.A0_MRCB);
	savesetting("PSU",HOUSINGINFODIC_DICT.PSU);
	savesetting("SSU",HOUSINGINFODIC_DICT.SSU);
	savesetting("HH",HOUSINGINFODIC_DICT.HH);
	savesetting("endx",1);
end;	

function onstop()
	savepartial();
	saveIdsForLogin();
end;




function OnChangeLanguage()
    savesetting("curLanguage",getlanguage());
end;

