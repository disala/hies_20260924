function numeric K04_1630_S3AQ13 ()
// K04 1630-column 13 can not be blank for all persons, has to be filled with 1 or 2. 
//if it is 2, section 3A is [ict not] complete for him/her.
String vilatedSN;
	do varying numeric i=1 until i>totocc(SECTION_3A_HEALTH)
		if S3AQ13(i)=Notappl or Not S3AQ13(i) in 1,2 then 
			vilatedSN=vilatedSN+ maketext("[Row: %d] ",i);
		endif;
		if S3AQ13(i)=2 then
			if (S3AQ14(i)<>NOTAPPL) or (S3AQ15(i)<>NOTAPPL) or (S3AQ16(i)<>NOTAPPL) or (S3AQ171(i)<>NOTAPPL) or (S3AQ172(i)<>NOTAPPL) or (S3AQ18(i)<>NOTAPPL) or (S3AQ19(i)<>NOTAPPL) or (END_SEC_3A(i)<>NOTAPPL) then
				vilatedSN=vilatedSN+ maketext("[Row: %d] ",i);
			endif;
		endif;
	enddo;

	if strip(vilatedSN)<>"" then
		sem (maketext(7001630,vilatedSN),"E");
		errmsg (7001630,vilatedSN) select("Edit Health",SECTION_3A_HEALTH000,"Pass",continue);
		pass();
	endif;
end;

