PROC SAVESTATUS_HCMOD
if SAVESTATUS_HCMOD = 1 then  
errmsg("Successfully Saved Hies and Child module for this MRCB -%6d,PSU- %3d,SSU -%2d,HH - %1d household.",A0_MRCB,PSU,SSU,HH); 
savepartial(); 
skip to COMPLETE_HCMOD; 
else if  
$ = 2 then  
 savepartial();
 saveIdsForLogin();  
  else  
 saveIdsForLogin(); 
  endif; 
  endif; 

PROC COMPLETE_HCMOD
preproc  
ask if SAVESTATUS_HCMOD =1; 
if SAVESTATUS_HCMOD =1 then  
COMPLETE_HCMOD =1; 
endif;

postproc
if  COMPLETE_HCMOD =1 then
//setfile(ModuleCompleteness,"../reports/CompleteModule/ModuleCompleteness.txt"); 

file ModuleCompleteness; 
ModuleCompleteness.open("../reports/CompleteModule/ModuleCompleteness.txt", append); 
//ModuleCompleteness.write("%s, %s, %d", getdeviceid(), getoperatorid(), timestamp()); 
ModuleCompleteness.write("%8d,%6d,%3d,%2d,%2d,%v,%v",sysdate("YYYYMMDD"),A0_MRCB,PSU,SSU,HH,getlabel(MODULENO_VS2,MODULENO),getlabel(COMPLETE_HCMOD_VS1,COMPLETE_HCMOD)); 
ModuleCompleteness.close();
saveIdsForLogin();	
endif; 

