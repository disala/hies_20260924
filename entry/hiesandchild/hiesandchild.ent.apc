function numeric K04_1700_SEC_1_DEMOGRAPHY_SECTION_SECTION_3B_SECTION_3B_HEALTH_NEUROLOGIC ()
// K04 1700-Names of the all persons filled code 1 in column 3 of section 1 , and the value in 
//column 7 of section over 5, should be included In column 1 shortly.
	String vilatedSN;
	numeric found;
	do varying numeric i=1 until i>totocc(SEC_1_DEMOGRAPHY)
		if S1Q3(i)=1 and S1Q7(i)>5 then
			found=seek(SECTION_3B_SECTION_3B_HEALTH_NEUROLOGIC.S3BQ2=S1Q1(i));
			if found=0 then
				vilatedSN=vilatedSN+ maketext("[Row: %d] ",i);
			endif;
		endif;
	enddo;

	if strip(vilatedSN)<>"" then
		sem (maketext(7001700,vilatedSN),"E");
		errmsg (7001700,vilatedSN) select("Edit Demography",SEC_1_DEMOGRAPHY000,"Edit Health",SECTION_3B_SECTION_3B_HEALTH_NEUROLOGIC000,"Pass",continue);
		pass();
	endif;
end;

function numeric K04_1710_SEC_1_DEMOGRAPHY_SECTION_SECTION_3B_SECTION_3B_HEALTH_NEUROLOGIC ()
// K04 1710-Serial numbers of the all persons in column 1 need to mention in column 2 as 
//mentioned in column 1 of section 1. 
//Count of persons in here should be equal to count of persons with code 1 in section 1 column 3.
	String vilatedSN;
	numeric found;
	
	do varying numeric i=1 until i>totocc(SEC_1_DEMOGRAPHY)
		if S1Q3(i) = 1 then
			found=seek(SECTION_3B_SECTION_3B_HEALTH_NEUROLOGIC.S3BQ2=S1Q1(i));
		endif;
		if found=0 then
				vilatedSN=vilatedSN+ maketext("[Row: %d] ",i);
			endif;
	enddo;
	numeric person_Count_from_demog=count (SEC_1_DEMOGRAPHY where S1Q3=1);
	numeric person_Count_from_neuro=count(SECTION_3B_SECTION_3B_HEALTH_NEUROLOGIC);
	if person_Count_from_demog<>person_Count_from_neuro then
		vilatedSN=maketext("[Demograpy:%d , Health:%d]",person_Count_from_demog,person_Count_from_neuro);
	endif;

	if strip(vilatedSN)<>"" then
		sem (maketext(7001710,vilatedSN),"E");
		errmsg (7001710,vilatedSN) select("Edit Demography",SEC_1_DEMOGRAPHY000,"Edit Health",SECTION_3B_SECTION_3B_HEALTH_NEUROLOGIC000,"Pass",continue);
		pass();
	endif;
end;

