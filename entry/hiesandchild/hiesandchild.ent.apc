function numeric K02_720_C2_CHILD_WEIGHTKILO_C2_CHILD_WEIGHTGRAMES () 
//K02-720-Weight of the child in C2 in CM should be in the range of 
//0.500 kg 500g and 20.000kg 000g and the numbers 99.994, 99.995 and 99.996 should be accept.
string vilatedSN;
	do varying numeric i=1 until i>totocc(M1CHILDREN_REC)
		if NOT C2_CHILD_WEIGHTKILO(i) in 0.5:20 and NOT C2_CHILD_WEIGHTGRAMES in 0:999 then
			if C2_CHILD_WEIGHTKILO(i)=99 and NOT C2_CHILD_WEIGHTGRAMES in 994:996 then
				vilatedSN=vilatedSN+ maketext("[Row: %d] ",i);
			endif;
		endif;
	enddo;	

	if strip(vilatedSN)<>"" then
		sem (maketext(7000720,vilatedSN),"E");
		errmsg (7000720,vilatedSN) select("Edit Child",M1CHILDREN_REC000,"Pass",continue);
		pass();
	endif;
end;

