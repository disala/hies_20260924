//file AllHHmembers;


function goto()
numeric section = accept(maketext(1),
                             maketext(2),
                             maketext(3),
							 maketext(4),
                             maketext(5),
							 maketext(6),
							 maketext(7),
							 maketext(8),
							 maketext(9));								 
						
    if section = 1 then
	move to SEC_1_DEMOGRAPHY_FORM advance;
    elseif section = 2 then
        move to  SEC_2_PRESCHOOL_SCHOOL_FORM advance;
    elseif section = 3 then
        move to  SECTION_3A_HEALTH_FORM advance;
	elseif section = 4 then
        move to  SECTION_3B_SECTION_3B_HEALTH_NEUROLOGIC_FORM advance;
	elseif section = 5 then
		move to  CONTROL_CHILDMODULE_FORM advance;	
	elseif section = 6 then
		move to  SEC_4_3_IS_BOADERS_FORM advance;
	elseif section = 7 then
		move to  SEC_5_1_IS_EMP_INCOME_FORM advance;
	elseif section = 8 then
		move to  SEC_5_2_AGRI_INCOME000 advance;	
	 elseif section = 9 then
		move to  SEC_5_5_1_OTHER_INCOME000 advance;
	 endif;	
end;

function sem (String mes, string color) // show err message
	userbar(clear);
	userbar(add Button,maketext(1005),goto());
	userbar(add button,"Check",do("AdvanceToEnd"));
	userbar(add text,mes);
	if toupper(color)="E" then // E - Erro
		userbar(set color,248,171,143);  
	else
		userbar(set color,190,224,160); 
	endif;
	userbar(show);
end;
function pass()
	sem("Pass","");
end;
{-- Edit Functions Start}



function K01_10_S1Q1()
// 10- K01  Col 1 to 11 can not be blank for all the persons in section 1.
string vilatedSN="";
numeric foundBlank;
	do varying numeric i=1 until i>totocc(SEC_1_DEMOGRAPHY)
		foundBlank=0;
		if S1Q1(i)=notappl then	foundBlank=1;vilatedSN=vilatedSN+ maketext("[Row: %d] ",i);  next; endif;
		
		if strip(S1Q2(i))=""  then foundBlank=1;vilatedSN=vilatedSN+ maketext("[Row: %d] ",i);  next; endif;	
		
		if S1Q3(i)=notappl then	foundBlank=1;vilatedSN=vilatedSN+ maketext("[Row: %d] ",i);  next; endif;
		if S1Q4(i)=notappl then	foundBlank=1;vilatedSN=vilatedSN+ maketext("[Row: %d] ",i);  next; endif;
		if S1Q5(i)=notappl then	foundBlank=1;vilatedSN=vilatedSN+ maketext("[Row: %d] ",i);  next; endif;
		if S1Q6YEAR(i)=notappl then	foundBlank=1;vilatedSN=vilatedSN+ maketext("[Row: %d] ",i);  next; endif;
		if S1Q6MONTH(i)=notappl then foundBlank=1;vilatedSN=vilatedSN+ maketext("[Row: %d] ",i);  next; endif;
		if S1Q7(i)=notappl then	foundBlank=1;vilatedSN=vilatedSN+ maketext("[Row: %d] ",i);  next; endif;
		if S1Q8(i)=notappl then	foundBlank=1;vilatedSN=vilatedSN+ maketext("[Row: %d] ",i);  next; endif;
		if S1Q9(i)=notappl then	foundBlank=1;vilatedSN=vilatedSN+ maketext("[Row: %d] ",i);  next; endif;
		if S1Q10(i)=notappl then foundBlank=1;vilatedSN=vilatedSN+ maketext("[Row: %d] ",i);  next; endif;
		if S1Q11(i)=notappl then foundBlank=1;vilatedSN=vilatedSN+ maketext("[Row: %d] ",i);  next; endif;
	enddo;
	if strip(vilatedSN)<>"" then
		sem (maketext(7000010,vilatedSN),"E");
		errmsg (7000010,vilatedSN) select("Edit Demography",SEC_1_DEMOGRAPHY000,"Pass",continue);
		pass();
	endif;
end;

function K01_20_S1Q3_S1Q22_S1Q23()
// 20- K01  If code of Col 3 in section 1 is 2 then col 22 and col 23 in section1 should be blank
string vilatedSN="";
	do varying numeric i=1 until i>totocc(SEC_1_DEMOGRAPHY)
		if S1Q3(i)=2 then
			if S1Q22(i)=notappl or S1Q23(i)=notappl then
				vilatedSN=vilatedSN+ maketext("[Row: %d] ",i);
			endif;
		endif;
	enddo;
	if strip(vilatedSN)<>"" then
		sem (maketext(7000020,vilatedSN),"E");
		errmsg (7000020,vilatedSN) select("Edit Demography",SEC_1_DEMOGRAPHY000,"Pass",continue);
		pass();
	endif;
end;

function K01_30_S1Q3_S1Q22_S1Q23()
// ERROR IN GIVEN BY DIV 9 / we add not 2
// 30- K01  If code of Col 3 in section 1 is not 2 then 
// col 22 and col 23 in section1 should not be blank
string vilatedSN="";
	do varying numeric i=1 until i>totocc(SEC_1_DEMOGRAPHY)
		if S1Q3(i)<>2 then
			if S1Q22(i)<>notappl or S1Q23(i)<>notappl then
				vilatedSN=vilatedSN+ maketext("[Row: %d] ",i);
			endif;
		endif;
	enddo;
	if strip(vilatedSN)<>"" then
		sem (maketext(7000030,vilatedSN),"E");
		errmsg (7000030,vilatedSN) select("Edit Demography",SEC_1_DEMOGRAPHY000,"Pass",continue);
		pass();
	endif;
end;

function K01_40_S1Q3_S1Q12_to_S1Q21()
// 40- K01  If code of Col 3 in section 1 is 2 then col 12 to col 21 in section1 should be blank
string vilatedSN="";
numeric foundBlank;
	do varying numeric i=1 until i>totocc(SEC_1_DEMOGRAPHY)
		foundBlank=0;
		if S1Q3(i)=2 then
			if S1Q12(i)<>notappl then foundBlank=1;vilatedSN=vilatedSN+ maketext("[Row: %d] ",i);  next; endif;
