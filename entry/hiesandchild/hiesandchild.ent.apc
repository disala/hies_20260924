		endif;
	enddo;

	if strip(vilatedSN)<>"" then
		sem (maketext(7000440,vilatedSN),"E");
		errmsg (7000440,vilatedSN) select("Edit Demography",SEC_1_DEMOGRAPHY000,"Pass",continue);
		pass();
