function K01_490_S1Q14_S1Q7 ()
// 490- K01  If studying in grade 1 (Col-14 = 00)
// then Age (Col-7) should be less than 7 years in section 1 (Persons).
string vilatedSN="";
	do varying numeric i=1 until i>totocc(SEC_1_DEMOGRAPHY)
		if S1Q14(i)=0 then
			if S1Q7(i)>=7 then
				vilatedSN=vilatedSN+ maketext("[Row: %d] ",i);
			endif;
		endif;
	enddo;

	if strip(vilatedSN)<>"" then
		sem (maketext(7000490,vilatedSN),"E");
