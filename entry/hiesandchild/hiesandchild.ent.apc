end;

function K01_430_S1Q13_S1Q7 ()
// 430- K01  If Current education status (Col-13) = 2 (School)
// then Age (Col-7) should be 5 - 19 in section 1 (Persons).
string vilatedSN="";
	do varying numeric i=1 until i>totocc(SEC_1_DEMOGRAPHY)
		if S1Q13(i)=2 then
			if not S1Q7(i) in 5:19 then
				vilatedSN=vilatedSN+ maketext("[Row: %d] ",i);
