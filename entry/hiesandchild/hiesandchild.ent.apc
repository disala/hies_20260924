PROC END_SEC51

if END_SEC51=3 then
Eduname.clear();

do varying eI=1 until eI>totocc(SEC_1_DEMOGRAPHY000) 
msno=S1Q1(ei);
mage = S1Q7(ei);
mname = S1Q2(ei); 
  st=0;
  if S1Q7(ei)>=15 and S1Q7(ei)<=99 and S1Q3(ei)=1 then
  do varying ej=1 until ej>totocc(SEC_5_1_EMP_INCOME000) 
  if S51BQ2(ej)=msno then st=1 endif;
  enddo;
  if st=1 then Eduname.add(concat(edit("99",msno)," - ", strip(mname), " - (Age:",edit("99",mage),") : completed")) endif;
  if st=0 then Eduname.add(concat(edit("99",msno)," - ", strip(mname), " - (Age:",edit("99",mage),") : Not Yet Started")) endif;

  endif;
  
enddo;	

Eduname.show("SECTION 5-1 : Employment Income");
reenter;
endif;

