PROC GLOBAL
numeric m,A_Hsex, A_age, A_difage, S111, A_j, A_sp, A_ek, A_ageCount, k,p,h1,ps,ps2,st,mage,msno,mrelationship,s2com,s2ncom,eI,ej,TOTALINCOMESEC51sum,TOTALINCOMESEC51sum1;
numeric ds,mures,msex,mbirthreg,methnicity,mreligion,mmaritalStatus,mpreg,mschoolatten,medulevel,mnvq,mmainact,mworknature,mecoact,mmainocu,mmainindustry,
