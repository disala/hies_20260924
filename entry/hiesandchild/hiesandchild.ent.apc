function K01_250_S1Q4 ()
// 250- K01  Only one Head of the household - Col 4 
//(Relationship)=1 is allowed.
numeric headCount=0;
string vilatedSN="";
	do varying numeric i=1 until i>totocc(SEC_1_DEMOGRAPHY)
		if S1Q4(i)=1 then
			inc(headCount);
			vilatedSN=vilatedSN+ maketext("[Row: %d] ",i);
		endif;
	enddo;
	if headCount>1 then
		sem (maketext(7000250,vilatedSN),"E");
		errmsg (7000250,vilatedSN) select("Edit Demography",SEC_1_DEMOGRAPHY000,"Pass",continue);
		pass();
	endif;
end;
function K01_260_S1Q4 ()
//260- K01  Head of the household Col 4 (Relationship)=1, 
// should be first normally living person in the household (col 1 = 1).

string vilatedSN="";
	do varying numeric i=1 until i>totocc(SEC_1_DEMOGRAPHY)
		if S1Q4(i)<>1 and i=1  then
			vilatedSN=vilatedSN+ maketext("[Row: %d] ",i);
			break;
		endif;
	enddo;
	if strip(vilatedSN)<>"" then
		sem (maketext(7000260,vilatedSN),"E");
		errmsg (7000260,vilatedSN) select("Edit Demography",SEC_1_DEMOGRAPHY000,"Pass",continue);
		pass();
	endif;
end;

function K01_270_S1Q4_S1Q5_S1Q9 ()
// 270- K01  Only one spouse (Col 4 (Relationship)=2) is 
// allowed for non-Muslim males or for any female in section 1 
numeric muslimHeadMaleFound=0;
numeric spouceCount=0;
string vilatedSN="";
	do varying numeric i=1 until i>totocc(SEC_1_DEMOGRAPHY)
		if S1Q4(i)=1 and S1Q5(i)=1 and S1Q9(i)=4 then 
			muslimHeadMaleFound=1;
		endif;
		if S1Q4(i)=2 then
			inc(spouceCount);
			vilatedSN=vilatedSN+ maketext("[Row: %d] ",i);
		endif;
	enddo;
	if spouceCount>1 and muslimHeadMaleFound=0 then
		sem (maketext(7000270,vilatedSN),"E");
		errmsg (7000270,vilatedSN) select("Edit Demography",SEC_1_DEMOGRAPHY000,"Pass",continue);
		pass();		
	endif;
end;

function K01_280_S1Q4_SEC4_3 ()
// 280- K01  If Col 4 (Relationship) = 6 or 7 then they 
//should be available in section 4.3 (Borders and Servents).
numeric found;
string vilatedSN;
	do varying numeric i=1 until i>totocc(SEC_1_DEMOGRAPHY)
		if S1Q4(i) in 6:7 then
			found=seek(SEC_4_3_BOARDERS.S43BQ2=S1Q1(i));
			if found=0 then
				vilatedSN=vilatedSN+ maketext("[Row: %d] ",i);
			endif;
		endif;
	enddo;
	if strip(vilatedSN)<>"" then
		sem (maketext(7000280,vilatedSN),"E");
		errmsg (7000280,vilatedSN) select("Edit Demography",SEC_1_DEMOGRAPHY000,"Pass",continue);
		pass();
	endif;
end;

function K01_300_S1Q4_S1Q7 ()
// 300- K01  For son or daughter Col 4(Relationship=3) the 
// age difference with the head should be at least 12 years in section 1 

numeric headsAge=0;
numeric ageDiff;
string vilatedSN;
	do varying numeric i=1 until i>totocc(SEC_1_DEMOGRAPHY)
		if i=1 and S1Q4(i)=1 and S1Q7(i)>0 then 
			headsAge=S1Q7(i);
			next;
		endif;
		if S1Q4(i)=3 and headsAge>0 then
			ageDiff=headsAge-S1Q7(i);
			if ageDiff<12 then
				vilatedSN=vilatedSN+ maketext("[Row: %d] ",i);
			endif;
		endif;
	enddo;
	if strip(vilatedSN)<>"" then
		sem (maketext(7000300,vilatedSN),"E");
		errmsg (7000300,vilatedSN) select("Edit Demography",SEC_1_DEMOGRAPHY000,"Pass",continue);
		pass();
	endif;
end;

function K01_310_S1Q4_S1Q7 ()
// 310- K01  For Parents Col 4(Relationship=4) the age 
// difference with the head 
// should be at least 12 years in section 1 (Persons).

numeric headsAge=0;
numeric ageDiff;
string vilatedSN;
	do varying numeric i=1 until i>totocc(SEC_1_DEMOGRAPHY)
		if i=1 and S1Q4(i)=1 and S1Q7(i)>0 then 
			headsAge=S1Q7(i);
			next;
		endif;
		if S1Q4(i)=4 and headsAge>0 then
			ageDiff=S1Q7(i)-headsAge;
			if ageDiff<12 then
				vilatedSN=vilatedSN+ maketext("[Row: %d] ",i);
			endif;
		endif;
	enddo;
	if strip(vilatedSN)<>"" then
		sem (maketext(7000310,vilatedSN),"E");
		errmsg (7000310,vilatedSN) select("Edit Demography",SEC_1_DEMOGRAPHY000,"Pass",continue);
		pass();
	endif;
end;

function K01_320_S1Q11_S1Q7 ()
// 320- K01  If marital status (Col 11) > 1 (ever married) 
// the age (Col-7) >= 12 years in section 1 (Persons).
string vilatedSN="";
	do varying numeric i=1 until i>totocc(SEC_1_DEMOGRAPHY)
		if S1Q11(i)>1 then
			if S1Q7(i)<12 then
				vilatedSN=vilatedSN+ maketext("[Row: %d] ",i);
			endif;
		endif;
	enddo;
	if strip(vilatedSN)<>"" then
		sem (maketext(7000320,vilatedSN),"E");
		errmsg (7000320,vilatedSN) select("Edit Demography",SEC_1_DEMOGRAPHY000,"Pass",continue);
		pass();
	endif;
end;

function K01_330_S1Q5_S1Q11_S1Q7_S1Q12 ()
//330- K01  If (col-5) = 2 & (col-11) = 1 & Age (Col.7) >= 15 
//then (Col.12) can not be blank in section 1 (Persons). 
string vilatedSN="";
	do varying numeric i=1 until i>totocc(SEC_1_DEMOGRAPHY)
		if S1Q5(i)=2 and S1Q11(i)=1 and S1Q7(i)>=15 then
			if S1Q12(i)=NOTAPPL then
				vilatedSN=vilatedSN+ maketext("[Row: %d] ",i);
			endif;
		endif;
	enddo;
	if strip(vilatedSN)<>"" then
		sem (maketext(7000330,vilatedSN),"E");
		errmsg (7000330,vilatedSN) select("Edit Demography",SEC_1_DEMOGRAPHY000,"Pass",continue);
		pass();
	endif;
end;

function K01_340_S1Q5_S1Q11_S1Q7_S1Q12 ()
// 340- K01  If (col-5) = 1 & (col-11) = 2 & Age (Col.7) < = 15 
// then (Col.12) can  be blank in section 1 (Persons). 
string vilatedSN="";
	do varying numeric i=1 until i>totocc(SEC_1_DEMOGRAPHY)
		if S1Q5(i)=1 and S1Q11(i)=2 and S1Q7(i)<=15 then
			if S1Q12(i)<>NOTAPPL then
				vilatedSN=vilatedSN+ maketext("[Row: %d] ",i);
			endif;
		endif;
	enddo;
	if strip(vilatedSN)<>"" then
		sem (maketext(7000340,vilatedSN),"E");
		errmsg (7000340,vilatedSN) select("Edit Demography",SEC_1_DEMOGRAPHY000,"Pass",continue);
		pass();
	endif;
end;

function K01_350_S1Q11_S1Q7 ()
// 350- K01  Recheck marital status (Col 10 ??) > 1 (ever married) 
// the age (Col-7) <= 17 years in section 1 (Persons).
string vilatedSN="";
	do varying numeric i=1 until i>totocc(SEC_1_DEMOGRAPHY)
		if S1Q11(i)>1 then
			if S1Q7(i)<=17 then
				vilatedSN=vilatedSN+ maketext("[Row: %d] ",i);
			endif;
		endif;
	enddo;
	if strip(vilatedSN)<>"" then
		sem (maketext(7000350,vilatedSN),"E");
		errmsg (7000350,vilatedSN) select("Edit Demography",SEC_1_DEMOGRAPHY000,"Pass",continue);
		pass();
	endif;
end;

function K01_360_S1Q4_S1Q7 ()
// 360- K01  Head of the household should be at least 12 years old
// (Col-7 >= 12) in section 1 (Persons).
string vilatedSN="";
	do varying numeric i=1 until i>totocc(SEC_1_DEMOGRAPHY)
		if S1Q4(i)=1 then
			if S1Q7(i)<12 then
				vilatedSN=vilatedSN+ maketext("[Row: %d] ",i);
			endif;
		endif;
		break;
	enddo;
	if strip(vilatedSN)<>"" then
		sem (maketext(7000360,vilatedSN),"E");
		errmsg (7000360,vilatedSN) select("Edit Demography",SEC_1_DEMOGRAPHY000,"Pass",continue);
		pass();
	endif;
end;

function K01_370_S1Q4_S1Q11 ()
// 370- K01  If there is a record for wife or husband
// Col-4 (Relationship=2), her or his marital status (Col-11)
// should be 2 or 3 in section 1 (Persons).
string vilatedSN="";
	do varying numeric i=1 until i>totocc(SEC_1_DEMOGRAPHY)
		if S1Q4(i)=2 then
			if not S1Q11(i)  in 2,3 then
				vilatedSN=vilatedSN+ maketext("[Row: %d] ",i);
			endif;
		endif;
	enddo;
	if strip(vilatedSN)<>"" then
		sem (maketext(7000370,vilatedSN),"E");
		errmsg (7000370,vilatedSN) select("Edit Demography",SEC_1_DEMOGRAPHY000,"Pass",continue);
		pass();
	endif;
end;

function K01_380_S1Q4_S1Q11 ()
// 380- K01  If there is a record for wife or husband
// Col-4 (Relationship=2), the head's marital status
// should be married (Col-11)=2 or 3 in section 1 (Persons).
string vilatedSN="";
numeric foundSpouse;
numeric headRow;

foundSpouse=0;
headRow=0;

do varying numeric i=1 until i>totocc(SEC_1_DEMOGRAPHY)
	if S1Q4(i)=1 then
		headRow=i;
	endif;
	if S1Q4(i)=2 then
		foundSpouse=1;
	endif;
enddo;

if foundSpouse=1 and headRow>0 then
	if not S1Q11(headRow) in 2,3 then
		vilatedSN=vilatedSN+ maketext("[Row: %d] ",headRow);
	endif;
endif;

if strip(vilatedSN)<>"" then
	sem (maketext(7000380,vilatedSN),"E");
	errmsg (7000380,vilatedSN) select("Edit Demography",SEC_1_DEMOGRAPHY000,"Pass",continue);
	pass();
endif;
end;

function K01_390_S1Q4_S1Q11 ()
// 390- K01  If there is a record for son or daughter
// Col-4 (Relationship=3), the marital status of the head
// (Col-11) cannot be 1 (Never married) in section 1 (Persons).
string vilatedSN="";
numeric foundChild;
numeric headRow;

foundChild=0;
headRow=0;

do varying numeric i=1 until i>totocc(SEC_1_DEMOGRAPHY)
	if S1Q4(i)=1 then
		headRow=i;
	endif;
	if S1Q4(i)=3 then
		foundChild=1;
	endif;
enddo;

if foundChild=1 and headRow>0 then
	if S1Q11(headRow)=1 then
		vilatedSN=vilatedSN+ maketext("[Row: %d] ",headRow);
	endif;
endif;

if strip(vilatedSN)<>"" then
	sem (maketext(7000390,vilatedSN),"E");
	errmsg (7000390,vilatedSN) select("Edit Demography",SEC_1_DEMOGRAPHY000,"Pass",continue);
	pass();
endif;
end;

function K01_400_S1Q4_S1Q11 ()
// 400- K01  For Parents Col-4 (Relationship = 4),
// the marital status (Col-11) cannot be 1 (Never married)
// in section 1 (Persons).
string vilatedSN="";
	do varying numeric i=1 until i>totocc(SEC_1_DEMOGRAPHY)
		if S1Q4(i)=4 then
			if S1Q11(i)=1 then
				vilatedSN=vilatedSN+ maketext("[Row: %d] ",i);
			endif;
		endif;
	enddo;

	if strip(vilatedSN)<>"" then
		sem (maketext(7000400,vilatedSN),"E");
		errmsg (7000400,vilatedSN) select("Edit Demography",SEC_1_DEMOGRAPHY000,"Pass",continue);
		pass();
	endif;
end;

function K01_410_S1Q4_S1Q11 ()
// K01 410 If the head of the household (Relationship = 1) is married 
// then  (Col-11 = 2 or 3)  the spouse Col 4 (Relationship = 2) 
//record should be available in section 1 (Persons).
numeric isHeadMarried=0;
string vilatedSN;
	do varying numeric i=1 until i>totocc(SEC_1_DEMOGRAPHY)
		if S1Q4(1)=1 and S1Q11(1)>1 and i=1 then
			isHeadMarried=1;
		endif;
		if i=1 then next; endif;
		if isHeadMarried=1 and S1Q4(i)<>2 then
			vilatedSN=vilatedSN+ maketext("[Row: %d] ",i);
		endif;
	enddo;
	if strip(vilatedSN)<>"" then
		sem (maketext(7000410,vilatedSN),"E");
		errmsg (7000410,vilatedSN) select("Edit Demography",SEC_1_DEMOGRAPHY000,"Pass",continue);
		pass();
	endif;
end;

