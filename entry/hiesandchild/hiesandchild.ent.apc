function K01_510_S1Q16_S1Q13 ()
// 510- K01  If not a student in normal activity (Col-16<>8)
// then he cannot be in a school (Col-13<>2) in section 1 (Persons).
string vilatedSN="";
	do varying numeric i=1 until i>totocc(SEC_1_DEMOGRAPHY)
		if S1Q16(i)<>8 then
			if S1Q13(i)=2 then
				vilatedSN=vilatedSN+ maketext("[Row: %d] ",i);
			endif;
		endif;
	enddo;

	if strip(vilatedSN)<>"" then
		sem (maketext(7000510,vilatedSN),"E");
		errmsg (7000510,vilatedSN) select("Edit Demography",SEC_1_DEMOGRAPHY000,"Pass",continue);
		pass();
	endif;
end;

function K01_520_S551BQ2 ()
// 520- K01  If a Pentioner in normal 
//activity (Col-16=2|4) in section 1 (Persons) 
//there must be an pention income (col-5) in section 5.5.1 
//(Other monetory Income).
numeric found;
string vilatedSN;
	do varying numeric i=1 until i>totocc(SEC_5_5_1_OTHER_INCOME)
		found=seek(SEC_1_DEMOGRAPHY.S1Q1=S551BQ2(i) and S1Q16 in 2,4);
		if found<>0 and S551BQ3(i)=NOTAPPL then
			vilatedSN=vilatedSN+ maketext("[Row: %d] ",i);
		endif;
	enddo;
	if strip(vilatedSN)<>"" then
		sem (maketext(7000520,vilatedSN),"E");
		errmsg (7000520,vilatedSN) select("Edit Demography",SEC_1_DEMOGRAPHY000,"Pass",continue);
		pass();
	endif;
end;


{IAABC}
//K2
function numeric K02_540_S1Q1_S1Q7_C1Q1 () // S1Q7=AGE
// K02-540-Everybody aged 0 - 17 (inclusive 17) 
// in column 7 of section 1 
// of HIES Questionnaire should be available in section 1 
// of Child Module(CM) .
String vilatedSN;
	do varying numeric j=1 until j>totocc(SEC_1_DEMOGRAPHY)
	 numeric found;
	 if S1Q7(j) in 0:17 then
		found=seek(M1CHILDREN_REC.C1Q1=S1Q1(j));
		if found=0 then
			vilatedSN=vilatedSN+ maketext("[Row: %d, SN: %d] ",j,S1Q1(j));
		endif;
	 endif;
	enddo;	

	if strip(vilatedSN)<>"" then
		sem (maketext(7000540,vilatedSN),"E");
		errmsg (7000540,vilatedSN) select("Edit Demography",SEC_1_DEMOGRAPHY000,"Edit Child",M1CHILDREN_REC000,"Pass",continue);
		pass();
	endif;

end;  // K02_540_S1Q1_S1Q7_C1Q1

function numeric K02_550_S1Q1_C1Q1 () 
// K02-550-The serial number in section 1 of CM 
// should be a number in column 1 of section 1 in HIES Quectionier
String vilatedSN;
	do varying numeric i=1 until i>totocc(M1CHILDREN_REC)
		numeric found;
		found=seek(SEC_1_DEMOGRAPHY.S1Q1=C1Q1(i));
		if found=0 then
			vilatedSN=vilatedSN+ maketext("[Row: %d, SN: %d] ",i,C1Q1(i));
		endif;
	enddo;	

	if strip(vilatedSN)<>"" then
		sem (maketext(7000550,vilatedSN),"E");
		errmsg (7000550,vilatedSN) select("Edit Demography",SEC_1_DEMOGRAPHY000,"Edit Child",M1CHILDREN_REC000,"Pass",continue);
		pass();
	endif;
end;

function numeric K02_560_C1Q1 () 
// K02-560-The serial number of the section 1 of CM can notbe repeated. 
list lstSN;
String vilatedSN;
	do varying numeric i=1 until i>totocc(M1CHILDREN_REC)
		if lstSN.seek(C1Q1(i))=0 then
			lstSN(lstSN.length()+1)=C1Q1(i);
		else
			vilatedSN=vilatedSN+ maketext("SN: %d] ",C1Q1(i));
		endif;
	enddo;	

	if strip(vilatedSN)<>"" then
		sem (maketext(7000560,vilatedSN),"E");
		errmsg (7000560,vilatedSN) select("Edit Demography",SEC_1_DEMOGRAPHY000,"Edit Child",M1CHILDREN_REC000,"Pass",continue);
		pass();
	endif;
end;

function numeric K02_570_C1Q1_S1Q7 () 
// K02-570-Age in section 1 of CM cannot be blank
String vilatedSN;
	do varying numeric i=1 until i>totocc(M1CHILDREN_REC)
		numeric found;
		found=seek(SEC_1_DEMOGRAPHY.S1Q1=C1Q1(i));
		if found<>0 and S1Q7(found)=NOTAPPL then
			vilatedSN=vilatedSN+ maketext("[Row: %d, SN: %d] ",found,C1Q1(i));
		endif;
	enddo;	

	if strip(vilatedSN)<>"" then
		sem (maketext(7000570,vilatedSN),"E");
		errmsg (7000570,vilatedSN) select("Edit Demography",SEC_1_DEMOGRAPHY000,"Pass",continue);
		pass();
	endif;
end;

function numeric K02_590_C1_1 () 
// K02-590-The place of residence of the biological mother 
// of the child cannot be blank in C1_1 in CM.
String vilatedSN;
	do varying numeric i=1 until i>totocc(M1CHILDREN_REC)
		if C1_1(i)=NOTAPPL then
			vilatedSN=vilatedSN+ maketext("[Row: %d] ",i);
		endif;
	enddo;	

	if strip(vilatedSN)<>"" then
		sem (maketext(7000590,vilatedSN),"E");
