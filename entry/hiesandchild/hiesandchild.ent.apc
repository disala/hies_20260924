function K01_500_S1Q16_S1Q7 ()
// 500- K01  If the main activity is student (Col-16=8)
// then Age (Col-7) should be less than 30 years in section 1 (Persons).
string vilatedSN="";
	do varying numeric i=1 until i>totocc(SEC_1_DEMOGRAPHY)
		if S1Q16(i)=8 then
			if S1Q7(i)>=30 then
				vilatedSN=vilatedSN+ maketext("[Row: %d] ",i);
			endif;
		endif;
