PROC S2Q2
preproc 
if count(SEC_1_DEMOGRAPHY000 where S1Q7 in 3:19 and S1Q3=1)=0 then skip to S3AQ2; endif; 

valueset SchoolMembers; 
do varying numeric i = 1 while i <= totocc(SEC_1_DEMOGRAPHY000) 
    numeric q1yes=0;    
    do varying numeric j = 1 while j <= totocc(SEC_2_PRESCHOOL_SCHOOL000) 
    if S1Q1(i)=S2Q2(j) then q1yes=1 endif; 
    enddo; 
    
  if S1Q7(i)>=3 and S1Q7(i)<=19 and S1Q3(i)=1 and q1yes=0 then 
  //if  insert new then totocc +1 //
  SchoolMembers.add(concat( edit("99",S1Q1(i))," : ", strip(S1Q2(i))," : Age=", edit("99",S1Q7(i)) ),S1Q1(i) );  
 // LFQ1.add(concat(edit("z9",serno(i))," : ",strip(pname(i))," : Age=", edit("ZZ9",Age(i)))); 
  
  endif; 
enddo; 
if SchoolMembers.length()=0 and count(SEC_2_PRESCHOOL_SCHOOL000)>0 then errmsg("SECTION 2:  PRE SCHOOL AND SCHOOL EDUCATION : completed"); skip to S3AQ2; endif; 
setvalueset(S2Q2,SchoolMembers); 

postproc 
