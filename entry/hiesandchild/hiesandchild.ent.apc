function numeric K02_680_S1Q1_S1Q7_C1Q1 () // S1Q7=AGE
// K02-680-Everybody aged 0 - 5 (ages 0,1,2,3,4) in column 7 
// in section 1 of HIES Questionnaire should be available 
// in section 2 of CM. 
String vilatedSN;
	do varying numeric j=1 until j>totocc(SEC_1_DEMOGRAPHY)
	 numeric found;
	 if S1Q7(j) in 0:4 then
		found=seek(M1CHILDREN_REC.C1Q1=S1Q1(j));
		if found=0 then
			vilatedSN=vilatedSN+ maketext("[Row: %d, SN: %d] ",j,S1Q1(j));
		endif;
	 endif;
	enddo;	

	if strip(vilatedSN)<>"" then
		sem (maketext(7000680,vilatedSN),"E");
		errmsg (7000680,vilatedSN) select("Edit Demography",SEC_1_DEMOGRAPHY000,"Edit Child",M1CHILDREN_REC000,"Pass",continue);
