// K03 start
function numeric K03_910_S1Q1_S1Q7_S1Q3_S2Q2 ()
// K03-910 Everybody aged 3 - 19 and usual residents (col-3 = 1) 
// in section 1 should be available in section 2 (School education)
String vilatedSN;
	do varying numeric i=1 until i>totocc(SEC_1_DEMOGRAPHY)
		numeric found;
		if S1Q7(i) in 3:19 and S1Q3(i)=1 then
			found=seek(SEC_2_PRESCHOOL_SCHOOL.S2Q2=S1Q1(i));
			if found=0 then
				vilatedSN=vilatedSN+ maketext("[Row: %d, SN: %d] ",i,S1Q1(i));
			endif;			
		endif;
	enddo;

	if strip(vilatedSN)<>"" then
		sem (maketext(7000910,vilatedSN),"E");
		errmsg (7000910,vilatedSN) select("Edit Demography",SEC_1_DEMOGRAPHY000,"Edit Pre School",SEC_2_PRESCHOOL_SCHOOL000,"Pass",continue);
		pass();
	endif;
end;

function numeric K03_920_SEC_1_DEMOGRAPHY_SEC_2_PRESCHOOL_SCHOOL ()
// K03-920 Total count of persons aged 3 - 19  and 
// usual residents (col-3 = 1) in section 1 
// should be equal to total count of persons in section 2 (School education)
String vilatedSN;

	numeric school_Count_from_demog=count (SEC_1_DEMOGRAPHY where S1Q7 in 3:19 and S1Q3=1);
	numeric school_Count_from_pre=count(SEC_2_PRESCHOOL_SCHOOL);
	if school_Count_from_demog<>school_Count_from_pre then
		vilatedSN=maketext("[Demograpy:%d , Preschool:%d]",school_Count_from_demog,school_Count_from_pre);
	endif;
	if strip(vilatedSN)<>"" then
		sem (maketext(7000920,vilatedSN),"E");
		errmsg (7000920,vilatedSN) select("Edit Demography",SEC_1_DEMOGRAPHY000,"Edit Pre School",SEC_2_PRESCHOOL_SCHOOL000,"Pass",continue);
		pass();
	endif;
end;


// K03 end

// K04 Start Nomali
function numeric K04_1510_SEC_1_DEMOGRAPHY_SECTION_3A_HEALTH_FORM ()
// K04-1510 Names of the all Persons in section 1 and column 3 
//filled with code 1 should be included In here shortly.
String vilatedSN;
numeric found;
	do varying numeric i=1 until i>totocc(SEC_1_DEMOGRAPHY)
		if S1Q3(i) = 1 then
			found=seek(SECTION_3A_HEALTH.S3AQ2=S1Q1(i));
			if found=0 then
				vilatedSN=vilatedSN+ maketext("[Row: %d] ",i);
			endif;
		endif;
	enddo;

	if strip(vilatedSN)<>"" then
		sem (maketext(7001510,vilatedSN),"E");
		errmsg (7001510,vilatedSN) select("Edit Demography",SEC_1_DEMOGRAPHY000,"Edit Health",SECTION_3A_HEALTH000,"Pass",continue);
		pass();
	endif;
end;

function numeric K04_1520_SEC_1_DEMOGRAPHY_SECTION_3A_HEALTH_FORM ()
// Serial numbers of the all persons in section 1 column 3 and filled with code 1 should be 
//included In column 2. Count of persons in here should be equal to count of persons 
//with code 1 in section 1 column 3.
	String vilatedSN;
	numeric found;
	
	do varying numeric i=1 until i>totocc(SEC_1_DEMOGRAPHY)
		if S1Q3(i) = 1 then
			found=seek(SECTION_3A_HEALTH.S3AQ2=S1Q1(i));
		endif;
		if found=0 then
				vilatedSN=vilatedSN+ maketext("[Row: %d] ",i);
			endif;
	enddo;
	numeric person_Count_from_demog=count (SEC_1_DEMOGRAPHY where S1Q3=1);
	numeric person_Count_from_health=count(SECTION_3A_HEALTH);
	if person_Count_from_demog<>person_Count_from_health then
		vilatedSN=maketext("[Demograpy:%d , Health:%d]",person_Count_from_demog,person_Count_from_health);
	endif;

	if strip(vilatedSN)<>"" then
		sem (maketext(7001520,vilatedSN),"E");
		errmsg (7001520,vilatedSN) select("Edit Demography",SEC_1_DEMOGRAPHY000,"Edit Health",SECTION_3A_HEALTH000,"Pass",continue);
		pass();
	endif;
end;

function numeric K04_1530_S3AQ3 ()
// column 3 can not be blank for all person, has to be filled with 1 or 2. 
//if it is 2, he/she need to be directed to column 6.
String vilatedSN;
	do varying numeric i=1 until i>totocc(SECTION_3A_HEALTH)
		if NOT S3AQ3(i) in 1,2 then 
			vilatedSN=vilatedSN+ maketext("[Row: %d] ",i);
		endif;
		if S3AQ3(i)=2 then
			skip to S3AQ6(i);
		endif;
	enddo;

	if strip(vilatedSN)<>"" then
		sem (maketext(7001530,vilatedSN),"E");
		errmsg (7001530,vilatedSN) select("Edit Health",SECTION_3A_HEALTH000,"Pass",continue);
		pass();
	endif;
end;

function numeric K04_1540_S3AQ3_S3AQ4 ()
// K04-1540 If 1 for column 3, column 4 should be 1, 2, 3, 4, 5, 6 or 9. 
//If it is 9, need to explain. If 2 for column 3, this should be empty.
String vilatedSN;
	do varying numeric i=1 until i>totocc(SECTION_3A_HEALTH)
		if S3AQ3(i)=1 then 
			if NOT S3AQ4(i) in 1,2,3,4,5,6,9 then
				vilatedSN=vilatedSN+ maketext("[Row: %d] ",i);
			endif;
		endif;
		if S3AQ3(i)=2 then
			if S3AQ4(i) <> Notappl then
				vilatedSN=vilatedSN+ maketext("[Row: %d] ",i);
			endif;
		endif;
	enddo;

	if strip(vilatedSN)<>"" then
		sem (maketext(7001540,vilatedSN),"E");
		errmsg (7001540,vilatedSN) select("Edit Health",SECTION_3A_HEALTH000,"Pass",continue);
		pass();
	endif;
end;

function numeric K04_1550_S3AQ3_S3AQ5 ()
// K04 1550-If 1 for column 3, coliumn 5 should be 1, 2, 3, 4, 5 or 9. 
//If it is 9, need to explain. If 2 for column 3, this should be empty.
String vilatedSN;
	do varying numeric i=1 until i>totocc(SECTION_3A_HEALTH)
		if S3AQ3(i)=1 then 
			if NOT S3AQ5(i) in 1,2,3,4,5,6,9 then
				vilatedSN=vilatedSN+ maketext("[Row: %d] ",i);
			endif;
		endif;
		if S3AQ3(i)=2 then
			if S3AQ4(i) <> Notappl then
				vilatedSN=vilatedSN+ maketext("[Row: %d] ",i);
			endif;
		endif;
	enddo;

	if strip(vilatedSN)<>"" then
		sem (maketext(7001550,vilatedSN),"E");
		errmsg (7001550,vilatedSN) select("Edit Health",SECTION_3A_HEALTH000,"Pass",continue);
		pass();
