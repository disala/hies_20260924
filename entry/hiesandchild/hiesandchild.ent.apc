function K01_470_S1Q13_S1Q7 ()
// 470- K01  If Current education status (Col-13) = 4 (Other edu)
// then Age (Col-7) should be 5 - 30 in section 1 (Persons).
string vilatedSN="";
	do varying numeric i=1 until i>totocc(SEC_1_DEMOGRAPHY)
		if S1Q13(i)=4 then
			if not S1Q7(i) in 5:30 then
				vilatedSN=vilatedSN+ maketext("[Row: %d] ",i);
			endif;
		endif;
	enddo;

	if strip(vilatedSN)<>"" then
