function K01_480_S1Q13_S1Q7 ()
// 480- K01  If Current education status (Col-13) = 5 (Technical)
// then Age (Col-7) should be 10 - 40 in section 1 (Persons).
string vilatedSN="";
	do varying numeric i=1 until i>totocc(SEC_1_DEMOGRAPHY)
		if S1Q13(i)=5 then
			if not S1Q7(i) in 10:40 then
				vilatedSN=vilatedSN+ maketext("[Row: %d] ",i);
