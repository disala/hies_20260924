end;

function K01_460_S1Q13_S1Q14 ()
// 460- K01  If Current education status (Col-13) = 3 (University)
// then Level of education (Col-14) cannot be less than 13
// in section 1 (Persons).
string vilatedSN="";
	do varying numeric i=1 until i>totocc(SEC_1_DEMOGRAPHY)
		if S1Q13(i)=3 then
			if S1Q14(i)<13 then
				vilatedSN=vilatedSN+ maketext("[Row: %d] ",i);
