function saveIdsForLogin() 
	savesetting("MODULENO",HIESANDCHILDDIC_DICT.MODULENO);
	savesetting("ENUID",strip(HIESANDCHILDDIC_DICT.ENUID));
	savesetting("A0_MRCB",HIESANDCHILDDIC_DICT.A0_MRCB);
	savesetting("PSU",HIESANDCHILDDIC_DICT.PSU);
	savesetting("SSU",HIESANDCHILDDIC_DICT.SSU);
	savesetting("HH",HIESANDCHILDDIC_DICT.HH);
	savesetting("endx",1);
end;

function onstop()
savepartial();
saveIdsForLogin();
end;


function OnChangeLanguage()
    savesetting("curLanguage",getlanguage());
end; 

function exitprogram()
	if accept(maketext(1001),maketext(1002),maketext(1003))=1 then
		execpff("HIES2025.pff", stop);
endif;
end;

