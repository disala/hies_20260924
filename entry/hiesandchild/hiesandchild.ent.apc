function numeric K02_820_C6A_C6A_COUNT_C6B_C6B_COUNT () 
//K02-820-Number of books should mention only if codes for 
// children's books(A), 
//Picture books(B) for the child 
//to use : C6 in CM  is 1, and number of books should 
// be in the range 00-10. 
string vilatedSN;
	do varying numeric i=1 until i>totocc(M1CHILDREN_REC)
		if C6A(i) = 1 or C6B(i) = 1 then
			if NOT C6A_COUNT(i) in 0:10 or NOT C6B_COUNT(i) in 0:10 then
				vilatedSN=vilatedSN+ maketext("[Row: %d] ",i);
			endif;
		endif;
	enddo;	

	if strip(vilatedSN)<>"" then
		sem (maketext(7000820,vilatedSN),"E");
		errmsg (7000820,vilatedSN) select("Edit Child",M1CHILDREN_REC000,"Pass",continue);
		pass();
	endif;
end;

function numeric K02_840_C7A_C7B_C7C_C7D () 
//K02-840-C7 in CM The things that child to play: for Homemade toys(A), Toys from a shop(B), 
//House hold objects, Digital divices(D) should be taken the codes 1,2 or 8.
string vilatedSN;
	do varying numeric i=1 until i>totocc(M1CHILDREN_REC)
		if NOT C7A(i) in 1,2,8 then 
			vilatedSN=vilatedSN+ maketext("[Row: %d] ",i);
			next;
		endif;
		if NOT C7B(i) in 1,2,8 then 
			vilatedSN=vilatedSN+ maketext("[Row: %d] ",i);
			next;
		endif;
		if NOT C7C(i) in 1,2,8 then 
			vilatedSN=vilatedSN+ maketext("[Row: %d] ",i);
			next;
		endif;
		if NOT C7D(i) in 1,2,8 then 
			vilatedSN=vilatedSN+ maketext("[Row: %d] ",i);
			next;
		endif;
	enddo;	

	if strip(vilatedSN)<>"" then
		sem (maketext(7000840,vilatedSN),"E");
		errmsg (7000840,vilatedSN) select("Edit Child",M1CHILDREN_REC000,"Pass",continue);
		pass();
	endif;
end;

function numeric K02_850_C8A_C8B_C8C_C8D_C8E () 
//K02-850-For quection C8 in CM: In the past 3 days, read books with child(A), 
//told stories to child(B), sang songs with child(C), 
//play with child(D), named, count or draw things(E) should be coded 1 or 2.   
string vilatedSN;
	do varying numeric i=1 until i>totocc(M1CHILDREN_REC)
		if (NOT C8A(i) in 1,2) or (NOT C8B(i) in 1,2) or (NOT C8C(i) in 1,2) or (NOT C8D(i) in 1,2) then 
			vilatedSN=vilatedSN+ maketext("[Row: %d] ",i);
		endif;
	enddo;	

	if strip(vilatedSN)<>"" then
		sem (maketext(7000850,vilatedSN),"E");
		errmsg (7000850,vilatedSN) select("Edit Child",M1CHILDREN_REC000,"Pass",continue);
		pass();
	endif;
end;

