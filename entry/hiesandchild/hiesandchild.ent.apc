msno=S1Q1(ei);
mage = S1Q7(ei);
mname = S1Q2(ei); 
  st=0;
  if S1Q3(ei)=1 then
  do varying ej=1 until ej>totocc(SEC_5_1_EMP_INCOME000) 
  if S51BQ2(ej)=msno then st=1 endif;
  enddo;
  if st=1 then s2com=s2com+1 endif;
  if st=0 then s2ncom=s2ncom+1 endif;
  endif;
  
enddo;	
if s2ncom>0 then errmsg("SECTION 5-1 : Employment Income : completed=%d  &  Not Complete=%d",s2com,s2ncom) select("Continue",Continue,"Edit",END_SEC51(totocc(SEC_5_1_EMP_INCOME000)))  endif;
	endgroup;
endif;























