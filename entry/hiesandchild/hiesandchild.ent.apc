function K01_440_S1Q13_S2Q4 ()
// 440- K01  If Current education status (Col-13) = 2 (School)
// in section 1 (Persons), then Col-4 of section 2 (School Education)
// should be 1 (school going) for the person.
string vilatedSN="";
	do varying numeric i=1 until i>totocc(SEC_1_DEMOGRAPHY)
		if S1Q13(i)=2 then
			if S2Q4(i)<>1 then
				vilatedSN=vilatedSN+ maketext("[Row: %d] ",i);
