string vilatedSN="";
	do varying numeric i=1 until i>totocc(SEC_1_DEMOGRAPHY)
		if S1Q13(i)=1 then
			if not S1Q7(i) in 3:5 then
				vilatedSN=vilatedSN+ maketext("[Row: %d] ",i);
			endif;
		endif;
	enddo;

	if strip(vilatedSN)<>"" then
		sem (maketext(7000420,vilatedSN),"E");
		errmsg (7000420,vilatedSN) select("Edit Demography",SEC_1_DEMOGRAPHY000,"Pass",continue);
		pass();
