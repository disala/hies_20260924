			if S1Q18(i)<>notappl then foundBlank=1;vilatedSN=vilatedSN+ maketext("[Row: %d] ",i);  next; endif;
			if strip(S1Q19A(i))<>"" then foundBlank=1;vilatedSN=vilatedSN+ maketext("[Row: %d] ",i);  next; endif;
			if S1Q19(i)<>notappl then foundBlank=1;vilatedSN=vilatedSN+ maketext("[Row: %d] ",i);  next; endif;
			if strip(S1Q20A(i))<>"" then foundBlank=1;vilatedSN=vilatedSN+ maketext("[Row: %d] ",i);  next; endif;
			if S1Q20(i)<>notappl then foundBlank=1;vilatedSN=vilatedSN+ maketext("[Row: %d] ",i);  next; endif;
			if S1Q21(i)<>notappl then foundBlank=1;vilatedSN=vilatedSN+ maketext("[Row: %d] ",i);  next; endif;
		endif;
	enddo;
	if strip(vilatedSN)<>"" then
		sem (maketext(7000040,vilatedSN),"E");
		errmsg (7000040,vilatedSN) select("Edit Demography",SEC_1_DEMOGRAPHY000,"Pass",continue);
		pass();
	endif;
end;
