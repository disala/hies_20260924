function K04_1670_S3AQ13_S3AQ17 ()
// K04 1670-If 1 for column 13, column 17 should be less than or equal to the value in 
//column 7 of section 1. 
//If it is 2 for column 13, this should be empty.
numeric illnessTime;
numeric age;
string vilatedSN;
	do varying numeric i=1 until i>totocc(SECTION_3A_HEALTH)
		if S1Q13(i)=1 then
			illnessTime=(S3AQ171(i)*12)+S3AQ172(i);
			numeric personSN=seek(SEC_1_DEMOGRAPHY.S1Q1=S3AQ2(i));
			age=S1Q7(personSN)*12;
		else
			age=0
		endif;
		if illnessTime>age then
			vilatedSN=vilatedSN+ maketext("[Row: %d] ",i);
		endif;		
	enddo;
	if strip(vilatedSN)<>"" then
		sem (maketext(7001670,vilatedSN),"E");
		errmsg (7001670,vilatedSN) select("Edit Demography",SEC_1_DEMOGRAPHY000,"Pass",continue);
		pass();
	endif;
end;

