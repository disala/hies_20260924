questions:
  - name: MODULEMENU_DICT.INTERVIEW_STATUS
    conditions:
      - questionText:
          EN: |
            <p style="text-align: center;"><b><font color="#0000ff">HOUSEHOLD INCOME AND EXPENDITURE SURVEY</font></b></p><p style="text-align: center;"><b><font color="#0000ff">2025</font></b></p><p><b><font color="#ff00ff"><br></font></b></p><p><font color="#a300c0"></font></p><p></p><p></p><p><b><font color="#ff00ff">Select Interview Status</font></b></p><p></p><p></p><p></p><p></p>
          SI: |
            <p style="text-align: center; "><font color="#0000ff"><b><span style="font-size: 18px;">ගෘහ ඒකක&nbsp; ආදායම් සහ වියදම් සමීක්ෂණය</span></b></font><br></p><p style="text-align: center; "><b><font color="#0000ff">2025</font></b></p>
            
            <p><b><font color="#ff00ff"><br></font></b></p><p><font color="#a300c0"></font></p><p></p><p></p><p><font color="#ff00ff"><b style="">සම්මුඛ පරීක්ෂණ තත්ත්වය&nbsp;</b><b>තෝරන්න&nbsp;</b></font></p><p><br></p><p></p><p></p><p></p><p></p><p></p><p></p><p></p>
          TA: |
            <p style="text-align: center;"><b><font color="#0000ff">குடித்தனக் கூறின் வருமானம் மற்றும் செலவு பற்றிய அளவீடு </font></b></p><p style="text-align: center;"><b><font color="#0000ff">2025</font></b></p><p><b><font color="#ff00ff"><br></font></b></p><p><font color="#a300c0"></font></p><p></p><p></p><p><font color="#ff00ff"><b>நேர்கானல் தன்மையை தெரிவுசெய்க</b></font></p><div><b><font color="#0000ff"><br></font></b></div><p></p><p></p><p></p><p></p>
  - name: MODULEMENU_DICT.INT_STATUS_OTHERSPECIFY
    conditions:
      - questionText:
          EN: |
            <p style="text-align: center;"><b><font color="#0000ff">HOUSEHOLD INCOME AND EXPENDITURE SURVEY</font></b></p><p style="text-align: center;"><b><font color="#0000ff">2025</font></b></p><p><b><font color="#ff00ff"><br></font></b></p><p><font color="#a300c0"></font></p><p></p><p></p><p><b><font color="#ff00ff">Select Interview Status - If Other Specify</font></b></p><p></p><p></p><p></p><p></p>
          SI: |
            <p style="text-align: center; "><font color="#0000ff"><b><span style="font-size: 18px;">ගෘහ ඒකක&nbsp; ආදායම් සහ වියදම් සමීක්ෂණය</span></b></font><br></p><p style="text-align: center; "><b><font color="#0000ff">2025</font></b></p><p><font color="#a300c0"></font></p><p></p><p></p><p><font color="#ff00ff"><b style="">සම්මුඛ පරීක්ෂණ තත්ත්වය&nbsp;</b><b>තෝරන්න -&nbsp;</b></font><span style="background-color: rgb(248, 249, 250); font-family: inherit; font-size: 16px;"><font color="#ff00ff"><b>වෙනත් නම්, සඳහන් කරන්න</b></font></span></p><p></p><p></p><p></p><p></p><p></p><p></p><p></p>
          TA: |
            <p style="text-align: center;"><b><font color="#0000ff">குடித்தனக் கூறின் வருமானம் மற்றும் செலவு பற்றிய அளவீடு </font></b></p><p style="text-align: center;"><b><font color="#0000ff">2025</font></b></p><p><b><font color="#ff00ff"><br></font></b></p><p><font color="#a300c0"></font></p><p></p><p></p><p><font color="#ff00ff"><b>நேர்கானல் தன்மையை தெரிவுசெய்க</b></font><b><font color="#ff00ff">&nbsp;-&nbsp;</font></b><font color="#ff00ff"><b>ஏனைய</b></font><b style="color: rgb(255, 0, 255);">வை (அடுத்து விபரிக்கவும்)</b></p><p></p><p></p><p></p><p></p>
