function backtoModule()
	if accept(maketext(41),maketext(10),maketext(20))=1 then
	saveIdsForLogin();
    execpff("Module.pff", stop);   	
	endif;
end;
 	
 	
function showMenu()
	userbar(clear);
	//userbar(add Button,maketext(31),backtomain());
	//userbar(add Button,maketext(32),backtoModule());
	userbar(show);
end;

function OnChangeLanguage()
 savesetting("curLanguage",getlanguage());
end;



PROC DISASTERMODDIC_FF
// set the language at the start of the program, defaulting to English 
preproc 
string language=strip(loadsetting("curLanguage",""));
if language="" then 
	setlanguage("EN"); savesetting("curLanguage","EN");
else 
	setlanguage(language);
endif;
 showMenu();


PROC M2DISASTER_ROASTER000

PROC M21IFDISASTER
//errmsg("id 1 = %1d,%6s,%6d,%3d,%2d,%2d",2,DISASTERMODDIC_DICT.ENUID,DISASTERMODDIC_DICT.A0_MRCB,DISASTERMODDIC_DICT.PSU,DISASTERMODDIC_DICT.SSU,DISASTERMODDIC_DICT.HH); 
//errmsg("id 2= %1d,%6s,%6d,%3d,%2d,%2d",2,MODULEMENU_DICT.ENUID,MODULEMENU_DICT.A0_MRCB,MODULEMENU_DICT.PSU,MODULEMENU_DICT.SSU,MODULEMENU_DICT.HH); 
if M21IFDISASTER = 2 then 
skip to M21CONTINUE;
endif;
PROC M21CONTINUE
preproc

M21CONTINUE =1;
PROC M22DIFOTHER
preproc
ask if curocc(M2DISASTER_ROASTER000) = 5;

postproc
if $ = 2 then skip to M22D7; endif;
PROC M22DOTHER
preproc
ask if curocc(M2DISASTER_ROASTER000) = 5;

PROC SAVESTATUS_DISASTERMOD
if $ = 1 then 
errmsg("Successfully Saved disaster module for this MRCB -%6d,PSU- %3d,SSU -%2d,HH - %1d household.",
DISASTERMODDIC_DICT.A0_MRCB,DISASTERMODDIC_DICT.PSU,DISASTERMODDIC_DICT.SSU,DISASTERMODDIC_DICT.HH);
		savepartial();	 
		skip to COMP_DISASTERMOD;
		
else if $ = 2 then 
		savepartial();
		saveIdsForLogin();	
		
else if $ = 3 then 		  
		 saveIdsForLogin();
		 stop(1);		 
		  //execpff("Module.pff", stop);   
	endif;
endif;
endif;

{if $ = 4 then  
disasterRep=Disasterdetailrep(); 
close(disasterfile); 
view(filename(disasterfile)); 
reenter; 
endif; }

if $ = 4 then
viewDisasterHtml();
endif;
PROC COMP_DISASTERMOD
preproc 
ask if SAVESTATUS_DISASTERMOD =1;
if SAVESTATUS_DISASTERMOD =1 then 
COMP_DISASTERMOD =1;
endif;
postproc
if COMP_DISASTERMOD =1 then 
file ModuleCompleteness; 
ModuleCompleteness.open("../reports/CompleteModule/ModuleCompleteness.txt", append); 
//ModuleCompleteness.write("%s, %s, %d", getdeviceid(), getoperatorid(), timestamp()); 
ModuleCompleteness.write("%8d,%6d,%3d,%2d,%2d,%v,%v",sysdate("YYYYMMDD"),A0_MRCB,PSU,SSU,HH,getlabel(MODULENO_VS1,MODULENO),getlabel(COMP_DISASTERMOD_VS1,COMP_DISASTERMOD)); 
ModuleCompleteness.close();

saveIdsForLogin();		
endif; 
//execpff("disaster.pff", stop); 

{if COMP_DISASTERMOD = 1 then 

			
endif;}

	


