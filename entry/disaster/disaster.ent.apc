{Application 'DISASTER' logic file generated by CSPro}
PROC GLOBAL
numeric endx,ej;
file disasterfile,DisasterReport;
string disasterRep;

function saveIdsForLogin ()  
	savesetting("MODULENO",DISASTERMODDIC_DICT.MODULENO);
	savesetting("ENUID",strip(DISASTERMODDIC_DICT.ENUID));
	savesetting("A0_MRCB",DISASTERMODDIC_DICT.A0_MRCB);
	savesetting("PSU",DISASTERMODDIC_DICT.PSU);
	savesetting("SSU",DISASTERMODDIC_DICT.SSU);
	savesetting("HH",DISASTERMODDIC_DICT.HH);
	savesetting("endx",1);
end;

function onstop()
savepartial();
saveIdsForLogin();
end;

function exitprogram()
	if accept(maketext(50),maketext(10),maketext(20))=1 then
		execpff("HIES2025.pff", stop);
endif;
end;


function viewDisasterHtml()

//file AssignmentsReport;
{if !direxist(".\reports") then
					dircreate(".\reports\");
				endif;}
		open(DisasterReport);
		
		filewrite(DisasterReport,"<html><body>");
		filewrite(DisasterReport,"<table border=0><tr>");
	
		filewrite(DisasterReport,"<td></td><td align = center><b>Sampling Of Housing Units<b></td></tr>");
		filewrite(DisasterReport,"<td></td><td><b>Department Of Census and Statistics<b></td></tr>");
		filewrite(DisasterReport,"<td></td><td><b>Census Blocks Sampling Information<b></td></tr>");
		filewrite(DisasterReport,"<tr><td></td><td></td></tr>");
		filewrite(DisasterReport,"<tr><td></td><td></td></tr>");
		filewrite(DisasterReport,"<tr><td><font color=blue>ENUMERATORID:%6s </font></td><td></td><td><font color=blue>MRCB:%6d</font></td>",MENU_DICT.ENUID,MENU_DICT.SELECTMRCB);
		
		filewrite(DisasterReport,"</tr><tr><td></td></tr>");
		filewrite(DisasterReport,"<tr><td></td></tr>");
		filewrite(DisasterReport,"</table>");

		filewrite(DisasterReport,"<table border =0><tr>");
		
		filewrite(DisasterReport,"<p><b>Sampled Housing Information</b></p>");

		filewrite(DisasterReport,"</tr><tr><td></td></tr>");
		filewrite(DisasterReport,"<tr><td></td></tr>");
		filewrite(DisasterReport,"</table>");
		
		filewrite(DisasterReport,"<table border =1><tr>");
		filewrite(DisasterReport,"<td>SSU</td><td>L1 Serial NO</td><td>BNO</td><td>UNO</td><td>HHHEAD</td><td>Address</td></tr>");

{forcase DISASTERMODDIC_DICT where DISASTERMODDIC_DICT.ENUID=MENU_DICT.ENUID and DISASTERMODDIC_DICT.A0_MRCB= MENU_DICT.SELECTMRCB do
//while loadcase (ASSIGNMENTS_DICT where ASSIGNMENTS_DICT.ENUID=MENU_DICT.ENUID and ASSIGNMENTS_DICT.A0_MRCB= MENU_DICT.SELECTMRCB) =1 do
//while loadcase( LISTING_DICT ) = 1 do
//do numeric ctr = 1 while ctr <= totocc(ASSIGNMENTS_DICT)		
		filewrite(DisasterReport,"<tr><td>%3d</td>",ASSIGNMENTS_DICT.SSU);
		filewrite(DisasterReport,"<td>%3d</td>",ASSIGNMENTS_DICT.SN_L1);
		filewrite(DisasterReport,"<td>%4v</td>",ASSIGNMENTS_DICT.A11_BUILDING_NO);
		filewrite(DisasterReport,"<td>%4v</td>",ASSIGNMENTS_DICT.A12_HUNIT);
		filewrite(DisasterReport,"<td>%30s</td>",ASSIGNMENTS_DICT.HEADNAME);
		filewrite(DisasterReport,"<td>%130s</td></tr>",ASSIGNMENTS_DICT.ADD_LINE1);
		//filewrite(AssignmentsReport,"<td>%3d</td>");
	endfor;	}
	
do varying ej=1 until ej>totocc(M2DISASTER_ROASTER)  
//FileWrite(disasterfile,"  %2d    %-15s           %2d   %s     %s  : Residence(%s)",M21IFDISASTER(ej),strip(S1Q2(ej)),S1Q7(ej),getlabel(S1Q5_VS1,S1Q5(ej)),getlabel(S1Q4_VS1,S1Q4(ej)),getlabel(S1Q3_VS1,S1Q3(ej))); 
FileWrite(disasterfile,"  %v %v %v %v %v %v %v %v %v %v",M21IFDISASTER(ej),M21B(ej),M21C(ej),M21D(ej),M21E(ej),M21F(ej),M21G(ej),M21H(ej),M21I(ej),M21J(ej));
enddo; 
		
		filewrite(DisasterReport,"</table>");	
		filewrite(DisasterReport,"</body>");
		filewrite(DisasterReport,"</html>");
		
       close(DisasterReport);
		
		if getos() in 20:29 then // Android 
		
		string DisasterHtml ="html:file://" + pathconcat(Application, "./reports/DisasterReport.html");
		execsystem(DisasterHtml);
		else //Windows 
			view("./reports/DisasterReport.html", title := "Disaster Report", 
			width := 400, height := 600, showCloseButton := true);
			endif;	
		end;






function string Disasterdetailrep() 

FileWrite(disasterfile,"          Disaster Details"); 
FileWrite(disasterfile,"          ======================"); 
FileWrite(disasterfile,"  "); 

FileWrite(disasterfile,"M21IFDISASTER  M21B     M21C     M21D   M21E  M21F  M21G  M21H  M21I  M21J"); 
FileWrite(disasterfile,"......         ........ .....   .....    ... ...    ..... ....  ..... ...."); 

do varying ej=1 until ej>totocc(M2DISASTER_ROASTER)  
//FileWrite(disasterfile,"  %2d    %-15s           %2d   %s     %s  : Residence(%s)",M21IFDISASTER(ej),strip(S1Q2(ej)),S1Q7(ej),getlabel(S1Q5_VS1,S1Q5(ej)),getlabel(S1Q4_VS1,S1Q4(ej)),getlabel(S1Q3_VS1,S1Q3(ej))); 
FileWrite(disasterfile,"  %v %v %v %v %v %v %v %v %v %v",M21IFDISASTER(ej),M21B(ej),M21C(ej),M21D(ej),M21E(ej),M21F(ej),M21G(ej),M21H(ej),M21I(ej),M21J(ej));
enddo; 

end; 




