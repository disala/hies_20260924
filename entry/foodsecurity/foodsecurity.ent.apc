{Application 'FOODSECURITY' logic file generated by CSPro}
PROC GLOBAL

function saveIdsForLogin() 
	savesetting("MODULENO",FOODINSMODDIC_DICT.MODULENO);
	savesetting("ENUID",strip(FOODINSMODDIC_DICT.ENUID));
	savesetting("A0_MRCB",FOODINSMODDIC_DICT.A0_MRCB);
	savesetting("PSU",FOODINSMODDIC_DICT.PSU);
	savesetting("SSU",FOODINSMODDIC_DICT.SSU);
	savesetting("HH",FOODINSMODDIC_DICT.HH);
	savesetting("endx",1);
end;	

function onstop()
	savepartial();
	saveIdsForLogin();
end;

function backtomain()
	if accept(maketext(40),maketext(10),maketext(20))=1 then
		stop(1);
	endif;
end;

{function backtomain()
	if accept(maketext("Do you want to exit from the program"),maketext("Yes"),maketext("No"))=1 then
		stop(1);
		else 
		reenter;
	endif;
end;}

function backtoModule()
	if accept(maketext(41),maketext(10),maketext(20))=1 then
	savepartial();
	saveIdsForLogin();	
	endif;
end;
 	


function showMenu()
	userbar(clear);
	//userbar(add Button,maketext("Exit"),exitprogram());
	//userbar(add Button,maketext(32),backtoModule());
	//userbar(add Button,maketext("Back to Module Menu"),backtoMOD());
	userbar(show);
end;


function OnChangeLanguage()
    savesetting("curLanguage",getlanguage());
end;


function string heading1()
	heading1=maketext(1000);
end;

function string sectionHeading1()
	sectionHeading1=maketext(100);
end;
function string sectionHeading2()
	sectionHeading2 =maketext(200);
end;



PROC FOODINSMODDIC_FF
// set the language at the start of the program, defaulting to English 
 
preproc 
string language=strip(loadsetting("curLanguage",""));
if language="" then 
	setlanguage("EN"); savesetting("curLanguage","EN");
else 
	setlanguage(language);
endif;
 showMenu()

PROC FIM07A
if $ =1 then skip to FIM07B endif;

if $ in 2,8,9 then skip to FIM08A endif;
PROC FIM08A
if $ =1 then skip to FIM08B endif;

if $ in 2,8,9 then skip to FIMSEC2Q2 endif;

PROC SAVESTATUS_FSMOD
if $ = 1 then
savepartial(); 
errmsg(51,A0_MRCB,PSU,SSU,HH);
 skip to COMP_FOODSECMOD;
 else if $ = 2 then 
		 savepartial();
		  saveIdsForLogin(); 
 else 
		 //savepartial();  
		  saveIdsForLogin();
		  stop(1);		  //ask to add accept case
  endif;
  endif;



PROC COMP_FOODSECMOD
preproc 
ask if SAVESTATUS_FSMOD =1;
if SAVESTATUS_FSMOD =1 then 
COMP_FOODSECMOD =1;
endif;
postproc
if COMP_FOODSECMOD = 1 then 
file ModuleCompleteness; 
setfile(ModuleCompleteness,"../reports/CompleteModule/ModuleCompleteness.txt", update);
filewrite(ModuleCompleteness,"%6d,%3d,%2d,%2d,%1d,%1d",A0_MRCB,PSU,SSU,HH,MODULENO,COMP_FOODSECMOD);

saveIdsForLogin();
endif;
