          EN: |
            <p></p><p style="text-align: center;"><b><font color="#0000ff">HOUSEHOLD INCOME AND EXPENDITURE SURVEY</font></b><br></p><p style="text-align: center;"><b><font color="#0000ff">2025</font></b></p>
            
            <table class="table table-bordered"><tbody><tr><td><b style="color: rgb(0, 0, 255);"><span style="font-size: 14px;">MRCB Number</span></b></td><td><b style="color: rgb(0, 0, 255);"><span style="font-size: 14px;">PSU&nbsp;&nbsp;</span></b></td><td><b style="color: rgb(0, 0, 255);"><span style="font-size: 14px;">SSU</span></b></td><td><b><font color="#0000ff"><span style="font-size: 14px;">HH</span></font></b></td></tr>
