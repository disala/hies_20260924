PROC COMP_NONFOODMOD
preproc 
ask if SAVESTATUS_NONFOODMOD =1;
if SAVESTATUS_NONFOODMOD =1 then 
COMP_NONFOODMOD =1;
endif;
postproc
if COMP_NONFOODMOD = 1 then 
file ModuleCompleteness; 
setfile(ModuleCompleteness,"../reports/CompleteModule/ModuleCompleteness.txt", update);
filewrite(ModuleCompleteness,"%6d,%3d,%2d,%2d,%1d,%1d",A0_MRCB,PSU,SSU,HH,MODULENO,SAVESTATUS_NONFOODMOD);	
saveIdsForLogin();
endif;
