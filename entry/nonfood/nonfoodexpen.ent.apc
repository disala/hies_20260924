{Application 'NONFOODEXPEN' logic file generated by CSPro}
PROC GLOBAL
string codetextvalue, list42;

function saveIdsForLogin()  
	savesetting("MODULENO",NONFOODDIC_DICT.MODULENO);
	savesetting("ENUID",strip(NONFOODDIC_DICT.ENUID));
	savesetting("A0_MRCB",NONFOODDIC_DICT.A0_MRCB);
	savesetting("PSU",NONFOODDIC_DICT.PSU);
	savesetting("SSU",NONFOODDIC_DICT.SSU);
	savesetting("HH",NONFOODDIC_DICT.HH);
	savesetting("endx",1);
end;

function onstop()
savepartial();
saveIdsForLogin();
end;



//save
function OnChangeLanguage()
    savesetting("curLanguage",getlanguage());
end; 

function backtomain()
	if accept(maketext("Do you want to go to the main menu"),maketext("Yes"),maketext("No"))=1 then
		execpff("HIES2025.pff", stop);
endif;
end;

{function backtomain()
	if accept(maketext("Do you want to exit from the program"),maketext("Yes"),maketext("No"))=1 then
		stop(1);
	endif;
end;}


function showMenu()
	userbar(clear);
	//userbar(add Button,maketext("Exit"),exitprogram());
	userbar(add Button,maketext("Back to Main Menu"),backtomain());
	userbar(show);
end;

function string sectionHeadingNF()
	sectionHeadingNF =maketext("Non Food Sheet");
end;


