//....................................Create Zip Folder - code from F1  ................................................

function  string createZip(string venuid, numeric vmrcb);
    filedelete("..\checking\HIESDATA_*.zip");

    list string fileListAll;
    list string fileListAddToZip;


    dirlist(fileListAll, ".\output", "*.csdb");
	
    string mFileName;
	//if fileListAll.length() >0 then 
    do numeric ctr = 1 while ctr <= fileListAll.length()
        mFileName=toupper(fileListAll(ctr));
		//errmsg("Fist read files %v id %v",mFileName,venuid);
		if pos(strip(maketext(venuid)), mFileName)>0 then
			//errmsg("Second  read files %v",mFileName);
			
			if pos(strip(edit("999999",vmrcb)), mFileName)>0 then
                fileListAddToZip.add(fileListAll(ctr));
				//errmsg(104,mFileName);
            endif;
        endif;	
    enddo; 
	if fileListAddToZip.length() > 0 then
    string fileNameToTransfer=maketext("..\checking\HIESDATA_%s_%s_%s_%s_%s",venuid,edit("999999",vmrcb),getdeviceid(),edit("99999999",sysdate("YYYYMMDD")),edit("999999",systime()))+".zip" ;
    if compress(fileNameToTransfer, fileListAddToZip)>0 then
        createZipFiletoSend=fileNameToTransfer;
	errmsg(110);
    else
        createZipFiletoSend=""; 
    endif;
	else 
	errmsg(111);
endif; 
end; 

