function viewDisasterReport(string venuid, numeric vmrcb,numeric vpsu,numeric vssu,numeric vhh)

//file AssignmentsReport;
{if !direxist(".\reports") then
					dircreate(".\reports\");
				endif;}
		open(DisasterRep);
		
		filewrite(DisasterRep,"<html><body>");
		filewrite(DisasterRep,"<table border=0><tr>");
	
		filewrite(DisasterRep,"<td></td><td align = center><b>Disaster Module<b></td></tr>");
	
		filewrite(DisasterRep,"<tr><td><font color=blue>ENUMERATORID:%6s </font></td><td></td><td><font color=blue>MRCB:%6d</font></td>",MENU_DICT.ENUID,MENU_DICT.SELECTMRCB);
		
		filewrite(DisasterRep,"</tr><tr><td></td></tr>");
		filewrite(DisasterRep,"<tr><td></td></tr>");
		filewrite(DisasterRep,"</table>");

		filewrite(DisasterRep,"<table border =0><tr>");
		
		filewrite(DisasterRep,"<p><b>Sampled Housing Information</b></p>");
		


		filewrite(DisasterRep,"</tr><tr><td></td></tr>");
		filewrite(DisasterRep,"<tr><td></td></tr>");
		filewrite(DisasterRep,"</table>");
		
		filewrite(DisasterRep,"<table border =1><tr>");
		filewrite(DisasterRep,"<td>SSU</td><td>L1 Serial NO</td><td>BNO</td><td>UNO</td><td>HHHEAD</td><td>Address</td></tr>");

forcase DISASTERMODDIC_DICT where DISASTERMODDIC_DICT.ENUID=MENU_DICT.ENUID and DISASTERMODDIC_DICT.A0_MRCB= MENU_DICT.SELECTMRCB
and DISASTERMODDIC_DICT.PSU= MENU_DICT.SELECTPSU and DISASTERMODDIC_DICT.SSU= MENU_DICT.SELECTSSU and DISASTERMODDIC_DICT.HH= MENU_DICT.SELECTHH do

		filewrite(DisasterRep,"<tr><td>%3d</td>",DISASTERMODDIC_DICT.SSU);
		filewrite(DisasterRep,"<td>%3d</td>",DISASTERMODDIC_DICT.HH);
		filewrite(DisasterRep,"<td>%4v</td>",DISASTERMODDIC_DICT.M21IFDISASTER);
		filewrite(DisasterRep,"<td>%4v</td>",DISASTERMODDIC_DICT.M21B);
		//filewrite(ModuleReports1,"<td>%30s</td>",DISASTERMODDIC_DICT.M21C);
		//filewrite(ModuleReports1,"<td>%130s</td></tr>",DISASTERMODDIC_DICT.M21D);
		//filewrite(ModuleReports1,"<td>%3d</td>");
	endfor;	
		
		filewrite(DisasterRep,"</table>");	
		filewrite(DisasterRep,"</body>");
		filewrite(DisasterRep,"</html>");
		
       close(DisasterRep);
		
		if getos() in 20:29 then // Android 
		
		string DisasterHtml ="html:file://" + pathconcat(Application, "./reports/DisasterRep.html");
		execsystem(DisasterHtml);
		else //Windows 
			view("./reports/DisasterRep.html", title := "Disaster Module Report", 
			width := 400, height := 600, showCloseButton := true);
			endif;	
		end;	}
					
			
			
			
			
			
		
PROC MENU_DICT.ENUID //disala
preproc 

{
string EnuNameKey = "EnumeratorID";

if strip(loadsetting(EnuNameKey)) <> "" then
	MENU_DICT.ENUID = loadsetting(EnuNameKey);
	skip to MAINMENU;
	endif;
}
postproc
{
	string ftpServerUrl_2 = "ftp://localhost";
	if syncconnect(FTP,ftpServerUrl_2,"ftp_hies","123456") then
		syncdata(GET,USERS_DICT,"HQ0001"); 
		syncdisconnect(); 
	endif;
}
if strip(MENU_DICT.ENUID)="" then
	stop(1);
endif;
string password=prompt ("Password:",password);

numeric loginSuccess=0;

if loadcase(USERS_DICT,strip(MENU_DICT.ENUID)) then
	if strip(password)=strip(USERS_DICT.PW) then
		loginSuccess=1;
	else
		loginSuccess=0;
	endif;
else
	loginSuccess=0;
endif;

if loginSuccess=0 then
	errmsg ("Try again, Check USER ID and Password") select ("Reenter",continue,"Register User",continue);
	reenter;
endif;
if length(strip(MENU_DICT.ENUID))<>6 then
	errmsg ("User ID must 6 Charactes");
	stop(1);
endif;
if not direxist (maketext(".\..\checking\%s",strip(MENU_DICT.ENUID))) then
	dircreate(maketext(".\..\checking\%s",strip(MENU_DICT.ENUID)));
endif;
if savesetting("curUser",strip(MENU_DICT.ENUID))then

else
	errmsg ("User cannot go/ File permmision");
	stop(1);
endif;
{
if strip(MENU_DICT.ENUID) <> ""  then 

string tpw = prompt(maketext(109),password);
 numeric n=0;
	forcase USERS_DICT where USERS_DICT.ENUID=MENU_DICT.ENUID  do
				if tpw = maketext(USERS_DICT.ENUPW) and MENU_DICT.ENUID = USERS_DICT.ENUID then 
				n=1;
				else 
				n=2;	
			endif;
		//endif;
	endfor;
	if n=1 then
		errmsg(100);
		savesetting(EnuNameKey, maketext("%v", MENU_DICT.ENUID));
		skip to MAINMENU;
	else
		errmsg(101);
		reenter;
	endif;
		else 
		errmsg(102);
		reenter;
		endif;

}


PROC MENU_FF
{
preproc
string language=strip(loadsetting("curLanguage",""));

if language="" then 

	numeric lang =accept ("Select preferred language","සිංහල","தமிழ்","English");
	if lang=1 then 
		setlanguage("SI"); savesetting("curLanguage","SI");
	elseif lang=2 then
		setlanguage("TA"); savesetting("curLanguage","TA");
	elseif lang=3 then
		setlanguage("EN"); savesetting("curLanguage","EN");
	else
		setlanguage("EN"); savesetting("curLanguage","EN");
	endif;
else 
	setlanguage(language);
endif;

}
PROC MAINMENU
if $ =1 then 
errmsg(103);
move to MAINMENU; 
endif;

if $ =2 then 
skip to SELECTMRCB;
endif;
	
if $ = 3 then 
//Start Survey	3	
skip to SELECTMRCB;
endif;

if $ =4 then 
//createZip(string);
skip to SELECTMRCB; //create zip	4
endif;

if $ =5 then
//sendDataToHQ(string tenuid);
 //send data to HQ	5
skip to SELECTMRCB;  
endif;

if $ =6 then //Summary Reports		6
//move to MAINMENU; 
skip to SELECTMRCB;		 
endif;

if $ =99 then
if accept(maketext(50),maketext(10),maketext(20))=1 then
endApplication();
else
	reenter;
endif;
endif;	


PROC SELECTMRCB
preproc 

// Disala HIES_DS1221224481150
list string HIES_DS_files; 
hashmap numeric hm_chkMRCB (numeric);
String tempMRCB;
dirlist(HIES_DS_files, maketext(".\..\checking\%06s",MENU_DICT.ENUID), filter := "HIES_DS*.csdb"); 

do numeric i = 1 while i <= HIES_DS_files.length() 
	tempMRCB=path.getFileName(HIES_DS_files(i))[12:6]; // HIES_DS1221224481150
	hm_chkMRCB(tonumber(tempMRCB))=tonumber(tempMRCB);
enddo; 

// Disala End
string smrcb;
    ask if MAINMENU in 2:6;
	
    valueset mrcblist;
   
	mrcblist.add (maketext(30),0); 
	
	numeric mrcblists =0;
	
   
    forcase ASSIGNMENTS_DICT {where ASSIGNMENTS_DICT.ENUID=MENU_DICT.ENUID} do
		inc(mrcblists);
		if mrcblists > 0 then 
				
				string newmrcb=edit ("999999",ASSIGNMENTS_DICT.A0_MRCB);
				string newMonth= maketext("%v", S_MONTH);// trygetvaluelabal
				if mrcblist.codes.seek(ASSIGNMENTS_DICT.A0_MRCB) = 0 then
				// Disala
				if hm_chkMRCB.contains(tonumber(newmrcb)) then
					mrcblist.add (newmrcb+ "- Month " + newMonth,ASSIGNMENTS_DICT.A0_MRCB);
				endif;
			endif;
		else 
		errmsg(120);
			endif;
	enddo;
	
	//mrcblist.sort();
    setvalueset($,mrcblist);//ok
	savesetting(smrcb,MENU_DICT.SELECTMRCB);

	
postproc 
if MAINMENU = 2 then 
if $ = 0 then move to MAINMENU;	endif;
	viewAssignmentHtml(MENU_DICT.ENUID,MENU_DICT.SELECTMRCB);
		//close(AssignmentsReport);
		//view(filename(AssignmentsReport));
		reenter MAINMENU;
 //endif;
 endif;
 
if MAINMENU = 4 then 
if $ = 0 then move to MAINMENU;	endif;
	string zipcode = createZip(MENU_DICT.ENUID,MENU_DICT.SELECTMRCB);
		reenter MAINMENU;
 
 endif;

if MAINMENU = 5 then
if $ = 0 then move to MAINMENU;	endif; 
sendDataToHQ(MENU_DICT.ENUID,MENU_DICT.SELECTMRCB);
		reenter MAINMENU;
 //endif;
 endif;
 
{ if MAINMENU = 6 then  // completed status 
if $ = 0 then move to MAINMENU;	endif;
	viewAssignmentHtml(MENU_DICT.ENUID,MENU_DICT.SELECTMRCB);
		reenter MAINMENU;
 
 endif;}

		
	
if SELECTMRCB = 0 then    
move to MAINMENU;	
 endif;	
	
PROC SELECTPSU
preproc
 // Disala
 
list string HIES_DS_files; 
hashmap numeric hm_chkPSU (numeric);
String tempMRCB;
String tempPSU;
dirlist(HIES_DS_files, maketext(".\..\checking\%06s",MENU_DICT.ENUID), filter := "HIES_DS*.csdb"); 

do numeric i = 1 while i <= HIES_DS_files.length() 
	tempMRCB=path.getFileName(HIES_DS_files(i))[12:6]; // HIES_DS1221224481150
	if tonumber(tempMRCB)=SELECTMRCB then
		tempPSU=path.getFileName(HIES_DS_files(i))[18:3]; // HIES_DS1221224481150
		hm_chkPSU(tonumber(tempPSU))=tonumber(tempPSU);
	endif;
enddo; 
 
 // Disala End
string spsu;
    ask if MAINMENU in 3:6;
    valueset psulist;
   
	psulist.add (maketext(30),0);
	
	numeric psulists = 0;
	forcase ASSIGNMENTS_DICT where {ASSIGNMENTS_DICT.ENUID=MENU_DICT.ENUID and }ASSIGNMENTS_DICT.A0_MRCB=MENU_DICT.SELECTMRCB do
		 //inc(psulists);
		 
		 string newpsu=edit ("999",ASSIGNMENTS_DICT.PSU);
		 if psulist.codes.seek(ASSIGNMENTS_DICT.PSU) = 0 then
			 // Disala
			 if hm_chkPSU.contains(tonumber(newpsu)) then
				psulist.add (newpsu,ASSIGNMENTS_DICT.PSU);
			 endif;	
		 endif;
	enddo;
    setvalueset($,psulist);//ok
savesetting(spsu,MENU_DICT.SELECTPSU);
	
postproc
if SELECTPSU = 0 then    
move to SELECTMRCB;	
 endif;	
	
PROC SELECTSSU
preproc 
// Disala
list string HIES_DS_files; 
list numeric ssuInHIES;
list string ssuInHIESName;
String tempMRCB;
dirlist(HIES_DS_files, maketext(".\..\checking\%06s",MENU_DICT.ENUID), filter := maketext("HIES_DS*%06d%03d.csdb",SELECTMRCB,SELECTPSU)); 


if HIES_DS_files.length()>0 then

	setfile (HIESANDCHILDDIC_DICT,HIES_DS_files(1),update);
	
	forcase HIESANDCHILDDIC_DICT do 
		
		if count(HIESANDCHILDDIC_DICT.SEC_1_DEMOGRAPHY)>0 then
		//S1Q2=Name
			if ssuInHIES.seek(HIESANDCHILDDIC_DICT.SSU)=0 then // more than one household
				ssuInHIES(ssuInHIES.length()+1)=HIESANDCHILDDIC_DICT.SSU;
				ssuInHIESName(ssuInHIESName.length()+1) = HIESANDCHILDDIC_DICT.SEC_1_DEMOGRAPHY.S1Q2(1);
			endif;
		endif;
	enddo;
	//errmsg ("%s",checking(100,HIESANDCHILDDIC_DICT.PSU,HIESANDCHILDDIC_DICT.SSU,1));
	close(HIESANDCHILDDIC_DICT);
else
	// no file to be
	errmsg ("NO %s",HIES_DS_files(1));
	stop(0);
endif;


// Disala End
string sssu;
    ask if MAINMENU in 3:6; 
    valueset ssulist;
	gsupid ="";
   
	ssulist.add (maketext(30),0);
	numeric ssulists = 0;

	list numeric doneSSUList;
	
    forcase ASSIGNMENTS_DICT where ASSIGNMENTS_DICT.A0_MRCB=MENU_DICT.SELECTMRCB and 
			ASSIGNMENTS_DICT.PSU=MENU_DICT.SELECTPSU  do
		//inc(ssulists); 
		gsupid = ASSIGNMENTS_DICT.SUPID;
		string newssu;
		string newHeadName= maketext("%v", HEADNAME);
		numeric inHouseHold=ssuInHIES.seek(ASSIGNMENTS_DICT.SSU);
		if doneSSUList.seek(ASSIGNMENTS_DICT.SSU)=0 then
			if inHouseHold = 0 then
				newssu="[  ] SSU - " + edit ("99",ASSIGNMENTS_DICT.SSU);
				ssulist.add (newssu + " " + newHeadName ,ASSIGNMENTS_DICT.SSU);
			else
				newssu="[D] SSU - " + edit ("99",ASSIGNMENTS_DICT.SSU);
				ssulist.add (newssu + " " + ssuInHIESName(ASSIGNMENTS_DICT.SSU) ,ASSIGNMENTS_DICT.SSU);
			endif; 
			doneSSUList(doneSSUList.length()+1)=ASSIGNMENTS_DICT.SSU;
		endif;
	enddo;
	
    setvalueset($,ssulist);//ok
	savesetting(sssu,MENU_DICT.SELECTSSU);
	
postproc
if SELECTSSU = 0 then    
move to SELECTPSU;	
 endif;


 
PROC SELECTHH
preproc

// Disala
list string HIES_DS_files; 
list numeric ssuInHIES;
list string ssuInHIESName;
String tempMRCB;
dirlist(HIES_DS_files, maketext(".\..\checking\%06s",MENU_DICT.ENUID), filter := maketext("HIES_DS*%06d%03d.csdb",SELECTMRCB,SELECTPSU)); 


if HIES_DS_files.length()>0 then

	setfile (HIESANDCHILDDIC_DICT,HIES_DS_files(1),update);
	
	forcase HIESANDCHILDDIC_DICT where HIESANDCHILDDIC_DICT.SSU=SELECTSSU do 
		
		if count(HIESANDCHILDDIC_DICT.SEC_1_DEMOGRAPHY)>0 then
		//S1Q2=Name
			if ssuInHIES.seek(HIESANDCHILDDIC_DICT.HH)=0 then // more than one household
				ssuInHIES(ssuInHIES.length()+1)=HIESANDCHILDDIC_DICT.HH;
				ssuInHIESName(ssuInHIESName.length()+1) = HIESANDCHILDDIC_DICT.SEC_1_DEMOGRAPHY.S1Q2(1);
			endif;
		endif;
	enddo;
	//errmsg ("%s",checking(100,HIESANDCHILDDIC_DICT.PSU,HIESANDCHILDDIC_DICT.SSU,1));
	close(HIESANDCHILDDIC_DICT);
else
	// no file to be
	errmsg ("NO %s",HIES_DS_files(1));
	stop(0);
endif;



string shh;
    ask if MAINMENU in 3:6;
    valueset hhlist;
   
	hhlist.add (maketext(30),0);
	hhlist.add (maketext(40),99);
	numeric hhlists = 0;  
    forcase ASSIGNMENTS_DICT where ASSIGNMENTS_DICT.A0_MRCB=MENU_DICT.SELECTMRCB and ASSIGNMENTS_DICT.PSU=MENU_DICT.SELECTPSU and ASSIGNMENTS_DICT.SSU=MENU_DICT.SELECTSSU do
		
		 string newhh=edit ("99",ASSIGNMENTS_DICT.HH);
		 string newHeadName= maketext("%v", HEADNAME);//take this as headname2 in db
		 if hhlist.codes.seek(ASSIGNMENTS_DICT.HH) = 0 then
			if ssuInHIES.seek(ASSIGNMENTS_DICT.HH)=0 then
				hhlist.add ("[  ] - " + newhh +  newHeadName,ASSIGNMENTS_DICT.HH);
			else
				hhlist.add ("[D] - " + newhh +  ssuInHIESName(ssuInHIES.seek(ASSIGNMENTS_DICT.HH)),ASSIGNMENTS_DICT.HH);
			endif;
			
		 endif;
	enddo;
    setvalueset($,hhlist);//ok
	savesetting(shh,MENU_DICT.SELECTHH);		
	
postproc

if SELECTHH = 0 then    
move to SELECTSSU;	
 endif;
 // disala
string ENUIDbyFile=path.getFilename(HIES_DS_files(1))[6:6];
 if SELECTHH = 99 then    
    //addEditHH(gsupid,MENU_DICT.ENUID,MENU_DICT.SELECTMRCB,MENU_DICT.SELECTPSU,MENU_DICT.SELECTSSU,0);		
	// disala to be
	addEditHH(gsupid,ENUIDbyFile,MENU_DICT.SELECTMRCB,MENU_DICT.SELECTPSU,MENU_DICT.SELECTSSU,0);		
 endif;
 
if MAINMENU = 3 then // if Start Survey then 

//SelectModuleEntry(9,MENU_DICT.ENUID,MENU_DICT.SELECTMRCB,MENU_DICT.SELECTPSU,MENU_DICT.SELECTSSU,MENU_DICT.SELECTHH); 
// disala
SelectModuleEntry(9,ENUIDbyFile,MENU_DICT.SELECTMRCB,MENU_DICT.SELECTPSU,MENU_DICT.SELECTSSU,MENU_DICT.SELECTHH); 
endif;






	
PROC SELECTMOD
preproc
ask if MAINMENU = 6;
 
postproc
{if MAINMENU = 6 then  // seperate reports 
if $ = 0 then move to MAINMENU;	endif;
	viewModReports1(MENU_DICT.ENUID,MENU_DICT.SELECTMRCB,MENU_DICT.SELECTPSU,MENU_DICT.SELECTSSU,MENU_DICT.SELECTHH);
	reenter MAINMENU;
 endif;}
