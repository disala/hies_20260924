function sendDataToHQ(string venuid, numeric vmrcb);

today=sysdate("YYYYMMDD");
sday=edit("99999999",today);
errmsg(105);
 
// connect to the FTP server
ftpServerUrl = "ftp://203.94.94.78";

//if syncconnect(FTP,ftpServerUrl,"dcsusr","dcs@1234") then
if syncconnect(FTP,ftpServerUrl,"data_usr_lk","2Et9!XaRr") then
errmsg(106);
 string hasfile = "../checking/HIESDATA_*.zip";	
 if fileexist(hasfile) > 0	then 
	syncfile(PUT,"../checking/HIESDATA_*.zip",concat("/HIES/",sday,"/"));
				syncdisconnect();
				errmsg(107);
				else 
				//if not found the file please create zip folder first
				errmsg("create the Zip File first");
				endif;
	else
	errmsg(108);  
endif;
stop(1);
end;

// ------------------------------------------Select Module Entry pavithra--------------------------------------
function SelectModuleEntry(numeric tmoduleno,string tenuid,numeric tA0_mrcb,numeric tpsu,numeric tssu,numeric thh)

    pff dynamic_pff; 
	
	string passids = maketext(edit("9",tmoduleno) + tenuid + edit("999999",tA0_mrcb) + edit("999",tpsu)+ edit("99",tssu) + edit("99",thh));
	
    dynamic_pff.setproperty("Version", "CSPro 7.7"); 
    dynamic_pff.setproperty("AppType", "Entry");
	dynamic_pff.setproperty("ShowInApplicationListing", "Never"); 
	
	dynamic_pff.setproperty("Key",passids); 
    dynamic_pff.setproperty("StartMode", "Add"); 
	//dynamic_pff.setproperty("StartMode", "Modify"); 
    dynamic_pff.setproperty("Lock", "Delete,Verify"); 
	dynamic_pff.setproperty("Application", "Module.ent"); 
	dynamic_pff.setproperty("InputData", maketext("..\checking\%06s\MODULEDATA_%06s%06d%03d.csdb",MENU_DICT.ENUID,tenuid,tA0_mrcb,tpsu)); 
	dynamic_pff.setproperty("CommonStore", "..\support\j.sam"); 
	
	dynamic_pff.setproperty("ExternalFiles.HIESANDCHILDDIC_DICT",maketext("..\checking\%06s\HIES_%06s%06d%03d.csdb",MENU_DICT.ENUID,tenuid,tA0_mrcb,tpsu));
	dynamic_pff.setproperty("ExternalFiles.DISASTERMODDIC_DICT", maketext("..\checking\%06s\DISASTER_%06s%06d%03d.csdb",MENU_DICT.ENUID,tenuid,tA0_mrcb,tpsu)); 
	dynamic_pff.setproperty("ExternalFiles.FOODINSMODDIC_DICT", maketext("..\checking\%06s\FOODSECURITY_%06s%06d%03d.csdb",MENU_DICT.ENUID,tenuid,tA0_mrcb,tpsu));
	dynamic_pff.setproperty("ExternalFiles.FOODINSMODDIC_DICT", maketext("..\checking\%06s\FOODSHEET_%06s%06d%03d.csdb",MENU_DICT.ENUID,tenuid,tA0_mrcb,tpsu));
	dynamic_pff.setproperty("ExternalFiles.FOODINSMODDIC_DICT", maketext("..\checking\%06s\NONFOOD_%06s%06d%03d.csdb",MENU_DICT.ENUID,tenuid,tA0_mrcb,tpsu));
	dynamic_pff.setproperty("ExternalFiles.FOODINSMODDIC_DICT", maketext("..\checking\%06s\NONFOODP2_%06s%06d%03d.csdb",MENU_DICT.ENUID,tenuid,tA0_mrcb,tpsu));
	//dynamic_pff.setproperty("ExternalFiles.HOUSINGINFODIC_DICT", "..\checking\HOUSINGINFO_DS1103101400032.csdb");
	dynamic_pff.setproperty("ExternalFiles.HOUSINGINFODIC_DICT", maketext("..\checking\%06s\HOUSINGINFO_%06s%06d%03d.csdb",MENU_DICT.ENUID,tenuid,tA0_mrcb,tpsu));
	dynamic_pff.setproperty("UserFiles.HiesandChildReport", "reports\HiesandChildRep.html");
	dynamic_pff.setproperty("UserFiles.DisasterReport", "reports\DisasterRep.html"); 
	dynamic_pff.setproperty("UserFiles.FoodInsecReport", "reports\FoodInsecRep.html"); 
	dynamic_pff.setproperty("UserFiles.FoodSheetReport", "reports\FoodSheetRep.html");
	dynamic_pff.setproperty("UserFiles.NonFoodP1Report", "reports\NonFoodP1Rep.html"); 
	dynamic_pff.setproperty("UserFiles.NonFoodP2Report", "reports\NonFoodP2Rep.html"); 
	dynamic_pff.setproperty("UserFiles.HousingInfoReport", "reports\HousingInfoRep.html"); 

	
	dynamic_pff.setproperty("Parameter", "0"); 
    dynamic_pff.setproperty("OnExit", ".\HIES2025.pff");
	dynamic_pff.exec(); 
end; 

		
	
//---------------------------------Add new HH / Edit - pavithra-------------------------------------------	
function addEditHH(string tsupid,string tenuid,numeric tA0_mrcb,numeric tpsu,numeric tssu,numeric thh)

if thh = 0 then 
	numeric newhh =0; 
	forcase ASSIGNMENTS_DICT where ASSIGNMENTS_DICT.ENUID=MENU_DICT.ENUID and ASSIGNMENTS_DICT.A0_MRCB=MENU_DICT.SELECTMRCB  and   ASSIGNMENTS_DICT.PSU=MENU_DICT.SELECTPSU  and ASSIGNMENTS_DICT.SSU=MENU_DICT.SELECTSSU  do
	inc(newhh); 
	endfor; 
		thh = newhh+1;
	 endif;
    
	pff dynamic_pff; 
	
	string passids =tsupid + tenuid + edit("999999",tA0_mrcb) + edit("999",tpsu)+ edit("99",tssu) + edit("99",thh);

    dynamic_pff.setproperty("Version", "CSPro 7.7"); 
    dynamic_pff.setproperty("AppType", "Entry");
	
	dynamic_pff.setproperty("Key", passids); 
    dynamic_pff.setproperty("StartMode", "Add"); 
    dynamic_pff.setproperty("Lock", "Delete,Verify"); 

	dynamic_pff.setproperty("Application","assignments\assignments.ent"); 
    //dynamic_pff.setproperty("InputData", maketext("..\checking\NEWHH%05d%03d.csdb",tA0_mrcb,tpsu));
	dynamic_pff.setproperty("InputData", maketext("..\support\assignments.csdb"));
	dynamic_pff.setproperty("CommonStore", "..\support\j.sam");
	dynamic_pff.setproperty("Parameter", "0"); 
    dynamic_pff.setproperty("OnExit", ".\HIES2025.pff");
	dynamic_pff.exec(); 

end;
