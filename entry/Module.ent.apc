if SELECTMODULE = -1 then 
skip to SUMMARYREP; 
endif;

PROC COMPLETEMCODE

postproc 
if COMPLETEMCODE in 1:3 then 
COMPLETEMCODE = $;
SAVEMENUDATA =1;
savepartial();
//errmsg(" Module Completion Result Code Saved"); 
 {else if COMPLETEMCODE =4 then 
COMPLETEMCODE = $;
SAVEMENUDATA =1; }
skip to FINAL_RESULTOTHER;
endif;
 


PROC FINAL_RESULTOTHER
savepartial();
skip to  ENDM;
  
PROC ENDM
preproc
ENDM =1;
errmsg(100);
execpff("HIES2025.pff", stop);
PROC SUMMARYREP
if SUMMARYREP = -1 then 
move to SELECTMODULE; 
endif;

