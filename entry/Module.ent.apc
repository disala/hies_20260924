{Application 'MODULE' logic file generated by CSPro}
PROC GLOBAL
//file MCompReport;
numeric endx,hasfileMcHIES,hasfileMcDIS,hasfileSrDIS,hasfileMcFOODINS,hasfileMcFS,hasfileMcNFp1,hasfileMcNFp2,hasfileMcHI;
string editorUserId; // Disala curUser / editorUserId=loadsetting("curUser");
list string compModRep;
file DisasterRep,HiesandChildRep,FoodInsecRep,FoodSheetRep,NonFoodP1Rep,NonFoodP2Rep,HousingInfoRep;

//function string getpreviousIds(string tenuid,numeric tA0_mrcb,numeric tpsu)
function string getpreviousIds()
	MODULEMENU_DICT.MODULENO = tonumber(loadsetting("MODULENO")); 
	editorUserId=strip(loadsetting("curUser"));
	MODULEMENU_DICT.ENUID=loadsetting("ENUID");
	MODULEMENU_DICT.A0_MRCB=tonumber(loadsetting("A0_MRCB"));
	MODULEMENU_DICT.PSU=tonumber(loadsetting("PSU"));
	MODULEMENU_DICT.SSU=tonumber(loadsetting("SSU"));
	MODULEMENU_DICT.HH=tonumber(loadsetting("HH"));
end;	

//function string savepreviousIds(string tenuid,numeric tA0_mrcb,numeric tpsu)
function string savepreviousIds()
	savesetting("MODULENO",MODULEMENU_DICT.MODULENO);		
	savesetting("ENUID",strip(MODULEMENU_DICT.ENUID));
	savesetting("A0_MRCB",MODULEMENU_DICT.A0_MRCB);
	savesetting("PSU",MODULEMENU_DICT.PSU);
	savesetting("SSU",MODULEMENU_DICT.SSU);
	savesetting("HH",MODULEMENU_DICT.HH);
end;
		

function backtomain()
	if accept(maketext(60),maketext(10),maketext(20))=1 then
		execpff("HIES2025.pff", stop);
	endif;
end;


function showMenu()
	userbar(clear);
	userbar(add Button,maketext(40),backtomain());
	userbar(show);
end;

function OnChangeLanguage()
 savesetting("curLanguage",getlanguage());
end;

function onstop()
	savepartial();
end;


//---------------------------------view module reports- pavithra-------------------------------------------
function viewHiesandChildReport(string venuid, numeric vmrcb,numeric vpsu,numeric vssu,numeric vhh)

		open(HiesandChildRep);
		
		filewrite(HiesandChildRep,"<html><body>");
		filewrite(HiesandChildRep,"<table border=0><tr>");
	
		filewrite(HiesandChildRep,"<td></td><td align = center><b>HIES and Child Module <b></td></tr>");
	
		filewrite(HiesandChildRep,"<tr><td><font color=blue>ENUMERATORID:%6s </font></td><td></td><td><font color=blue>MRCB:%6d</font></td>",MENU_DICT.ENUID,MENU_DICT.SELECTMRCB);
		
		filewrite(HiesandChildRep,"</tr><tr><td></td></tr>");
		filewrite(HiesandChildRep,"<tr><td></td></tr>");
		filewrite(HiesandChildRep,"</table>");

		filewrite(HiesandChildRep,"<table border =0><tr>");
		
		filewrite(HiesandChildRep,"<p><b>hies and child report</b></p>");
		


		filewrite(HiesandChildRep,"</tr><tr><td></td></tr>");
		filewrite(HiesandChildRep,"<tr><td></td></tr>");
		filewrite(HiesandChildRep,"</table>");
		
		filewrite(HiesandChildRep,"<table border =1><tr>");
		filewrite(HiesandChildRep,"<td>SSU</td><td>L1 Serial NO</td><td>BNO</td><td>UNO</td><td>HHHEAD</td><td>Address</td></tr>");

forcase HIESANDCHILDDIC_DICT where HIESANDCHILDDIC_DICT.ENUID=MENU_DICT.ENUID and HIESANDCHILDDIC_DICT.A0_MRCB= MENU_DICT.SELECTMRCB
and HIESANDCHILDDIC_DICT.PSU= MENU_DICT.SELECTPSU and HIESANDCHILDDIC_DICT.SSU= MENU_DICT.SELECTSSU and HIESANDCHILDDIC_DICT.HH= MENU_DICT.SELECTHH do

		filewrite(HiesandChildRep,"<tr><td>%3d</td>",HIESANDCHILDDIC_DICT.SSU);
		filewrite(HiesandChildRep,"<td>%3d</td>",HIESANDCHILDDIC_DICT.HH);
		filewrite(HiesandChildRep,"<td>%4v</td>",HIESANDCHILDDIC_DICT.SURVEYMONTH);
		filewrite(HiesandChildRep,"<td>%4v</td>",HIESANDCHILDDIC_DICT.SURVEYDAY);
		//filewrite(ModuleReports1,"<td>%30s</td>",DISASTERMODDIC_DICT.M21C);
		//filewrite(ModuleReports1,"<td>%130s</td></tr>",DISASTERMODDIC_DICT.M21D);
		//filewrite(ModuleReports1,"<td>%3d</td>");
	endfor;	
		
		filewrite(HiesandChildRep,"</table>");	
		filewrite(HiesandChildRep,"</body>");
		filewrite(HiesandChildRep,"</html>");
		
       close(HiesandChildRep);
		
		if getos() in 20:29 then // Android 
		
		string HiesandChildRepHtml ="html:file://" + pathconcat(Application, "./reports/HiesandChildRep.html");
		execsystem(HiesandChildRepHtml);
		else //Windows 
			view("./reports/HiesandChildRep.html", title := "HiesandChild Module Report", 
			width := 400, height := 600, showCloseButton := true);
			endif;	
		end;	
				
