		 hasfileMcNFp1 = 1;
		 setfile(NONFOODDIC_DICT,hasNonFoodP1File);
		 else
		 compModRep.add(modName5 + "-" +status3);
		 endif;
    
//setfile(NONFOODDIC_DICT,hasNonFoodP1File);		
