PROC MODULEMENU_DICT.INT_STATUS_OTHERSPECIFY
skip to MODULEMENU_DICT.SAVEMENUDATA ; 


{MODULEMENU_DICT.INTERVIEW_STATUS
if MODULEMENU_DICT.INTERVIEW_STATUS = 9 then //other specify
skip to MODULEMENU_DICT.INT_STATUS_OTHERSPECIFY;
endif; }

PROC MODULEMENU_DICT.INTERVIEW_STATUS
{onfocus
if MODULEMENU_DICT.INTERVIEW_STATUS in 2:9 then 
numeric intst = errmsg("You have already noted this HH as, %d - Do you want to Change?",INTERVIEW_STATUS)
			select(maketext("Yes I want to Change the Interview Status?"),MODULEMENU_DICT.INTERVIEW_STATUS,maketext("No"),ENDM);
				if intst=2 then
				SAVEMENUDATA =1;
					skip to ENDM;
					else
					skip to MODULEMENU_DICT.INTERVIEW_STATUS;
		endif;
 endif;}


{preproc 
{if MODULEMENU_DICT.INTERVIEW_STATUS = notappl then MODULEMENU_DICT.INTERVIEW_STATUS = 1;
setproperty(MODULEMENU_DICT.INTERVIEW_STATUS, "Protected",true); 
skip to SELECTMODULE;
endif;}}
preproc
if endx= 1 then INTERVIEW_STATUS =1;
skip to MODULEMENU_DICT.SAVEMENUDATA ;
endif;

postproc
if MODULEMENU_DICT.INTERVIEW_STATUS in  1:7 then 
skip to MODULEMENU_DICT.SAVEMENUDATA ; 
endif; 

if MODULEMENU_DICT.INTERVIEW_STATUS = 9 then //other specify
skip to MODULEMENU_DICT.INT_STATUS_OTHERSPECIFY;
endif;

if MODULEMENU_DICT.INTERVIEW_STATUS = -1 then 
stop(1);
endif;
 
PROC MODULEMENU_DICT.MODULENO
preproc 
MODULEMENU_DICT.MODULENO = 9;


PROC MODULEMENU_DICT.SAVEMENUDATA
preproc
ask if MODULEMENU_DICT.INTERVIEW_STATUS in 1:9 ; 

if MODULEMENU_DICT.INTERVIEW_STATUS = 1 then MODULEMENU_DICT.SAVEMENUDATA = 1;
savepartial();
skip to SELECTMODULE;
endif;//ok
postproc

if MODULEMENU_DICT.INTERVIEW_STATUS in 2:7  and MODULEMENU_DICT.SAVEMENUDATA = 1 then  
  savepartial();
  errmsg("Successfully Saved");
  execpff("HIES2025.pff", stop);
  endif;
  
if MODULEMENU_DICT.INTERVIEW_STATUS in 2:7  and MODULEMENU_DICT.SAVEMENUDATA = 2 then  
  execpff("HIES2025.pff", stop);//exit without saving -- go to the main menu
  endif;
  
  if MODULEMENU_DICT.INTERVIEW_STATUS = 9  and MODULEMENU_DICT.SAVEMENUDATA = 1 then  
  savepartial();
  errmsg("Successfully Saved");
  execpff("HIES2025.pff", stop);
  endif;
  
  if MODULEMENU_DICT.INTERVIEW_STATUS = 9  and MODULEMENU_DICT.SAVEMENUDATA = 2 then  
  execpff("HIES2025.pff", stop);//exit without saving -- go to the main menu
  endif;
  
  if MODULEMENU_DICT.INTERVIEW_STATUS = -1 then 
  stop(1);
endif;
  
  
PROC MODULEMENU_FF
preproc
editorUserId=strip(loadsetting("curUser"));
string language=strip(loadsetting("curLanguage",""));
if language="" then 
	setlanguage("EN"); savesetting("curLanguage","EN");
else 
	setlanguage(language);
endif;
// showMenu();
 
 {function string getpreviousIds()
	MODULEMENU_DICT.MODULENO = tonumber(loadsetting("MODULENO")); 
	MODULEMENU_DICT.ENUID=loadsetting("ENUID");
	MODULEMENU_DICT.A0_MRCB=tonumber(loadsetting("A0_MRCB"));
	MODULEMENU_DICT.PSU=tonumber(loadsetting("PSU"));
end;

//function string savepreviousIds(string tenuid,numeric tA0_mrcb,numeric tpsu)
function string savepreviousIds()
	savesetting("MODULENO",MODULEMENU_DICT.MODULENO);		
	savesetting("ENUID",strip(MODULEMENU_DICT.ENUID));
	savesetting("A0_MRCB",MODULEMENU_DICT.A0_MRCB);
	savesetting("PSU",MODULEMENU_DICT.PSU);	
end;}
		

{if  endx = 0 then
	savesetting("ENUID",DISASTERMODDIC_DICT.ENUID);
	savesetting("A0_MRCB",DISASTERMODDIC_DICT.A0_MRCB);
	savesetting("PSU",DISASTERMODDIC_DICT.PSU);
	endx = 1 ; 			
	endif;

endif; }

endx = tonumber(sysparm());


if endx =0 then 
//saveperiousIds(MODULEMENU_DICT.ENUID,edit("999999",MODULEMENU_DICT.A0_MRCB),edit("999",MODULEMENU_DICT.PSU));
 //savepreviousIds(MODULEMENU_DICT.ENUID,maketext(MODULEMENU_DICT.A0_MRCB),maketext(MODULEMENU_DICT.PSU));
 savepreviousIds();
 else
 endx = tonumber(loadsetting("endx"));
 endif;

if endx =1 then 
//getpreviousIds(MODULEMENU_DICT.ENUID,MODULEMENU_DICT.A0_MRCB,MODULEMENU_DICT.PSU);
getpreviousIds();
//INTERVIEW_STATUS =1;
endif; 


PROC MODULEMENU_LEVEL

PROC SELECTMODULE 	
postproc
string status1 = maketext(301);
string status2 = maketext(302);
string status3 = maketext(303);
string modName1 = maketext(200);//1
string modName2 = maketext(300);//2
string modName3 = maketext(400);//3
string modName4 = maketext(500);//4
string modName5 = maketext(600);//5
string modName6 = maketext(700);//6
string modName7 = maketext(800);//7
//string modName7 = maketext("Module %d", HOUSINGINFODIC_DICT.MODULENO);//7

if  $ = 1 then 
	if countcases(HIESANDCHILDDIC_DICT WHERE 
	HIESANDCHILDDIC_DICT.MODULENO =1 and 
	HIESANDCHILDDIC_DICT.ENUID=MENU_DICT.ENUID and 
	HIESANDCHILDDIC_DICT.A0_MRCB=MENU_DICT.SELECTMRCB and 
	HIESANDCHILDDIC_DICT.PSU=MENU_DICT.SELECTPSU and 
	HIESANDCHILDDIC_DICT.SSU=MENU_DICT.SELECTSSU and 
	HIESANDCHILDDIC_DICT.HH =MENU_DICT.SELECTHH ) <> 0 then 
	
	hiesAndChildModify(1,MODULEMENU_DICT.ENUID,MODULEMENU_DICT.A0_MRCB,MODULEMENU_DICT.PSU,MODULEMENU_DICT.SSU,MODULEMENU_DICT.HH);
		
	else
	//errmsg("run add mode function");
	//hiesAndChildEntry(1,MENU_DICT.ENUID,MENU_DICT.SELECTMRCB,MODULEMENU_DICT.SELECTPSU,MODULEMENU_DICT.SELECTSSU,MODULEMENU_DICT.SELECTHH);
	hiesAndChildEntry(1,MODULEMENU_DICT.ENUID,MODULEMENU_DICT.A0_MRCB,MODULEMENU_DICT.PSU,MODULEMENU_DICT.SSU,MODULEMENU_DICT.HH);
endif;
	endif;

if  $ = 2 then
	disasterModEntry(2,MODULEMENU_DICT.ENUID,MODULEMENU_DICT.A0_MRCB,MODULEMENU_DICT.PSU,MODULEMENU_DICT.SSU,MODULEMENU_DICT.HH);
endif;

if  $ = 3 then
	foodSecurityModEntry(3,MODULEMENU_DICT.ENUID,MODULEMENU_DICT.A0_MRCB,MODULEMENU_DICT.PSU,MODULEMENU_DICT.SSU,MODULEMENU_DICT.HH);
	
endif;

if  $ = 4 then //Food sheet
	foodSheetEntry(4,MODULEMENU_DICT.ENUID,MODULEMENU_DICT.A0_MRCB,MODULEMENU_DICT.PSU,MODULEMENU_DICT.SSU,MODULEMENU_DICT.HH);

	//foodSheetEntry(4,MENU_DICT.ENUID,MENU_DICT.SELECTMRCB,MENU_DICT.SELECTPSU,MENU_DICT.SELECTSSU,MENU_DICT.SELECTHH);	
endif;
if  $ = 5 then //non Food sheet								 
	NonfoodEntry(5,MODULEMENU_DICT.ENUID,MODULEMENU_DICT.A0_MRCB,MODULEMENU_DICT.PSU,MODULEMENU_DICT.SSU,MODULEMENU_DICT.HH);
	
endif;

if  $ = 6 then //non Food sheet								 
	NonfoodEntryp2(6,MODULEMENU_DICT.ENUID,MODULEMENU_DICT.A0_MRCB,MODULEMENU_DICT.PSU,MODULEMENU_DICT.SSU,MODULEMENU_DICT.HH);	
endif;

if  $ = 7 then //housinginfo
	housingInfoEntry(7,MODULEMENU_DICT.ENUID,MODULEMENU_DICT.A0_MRCB,MODULEMENU_DICT.PSU,MODULEMENU_DICT.SSU,MODULEMENU_DICT.HH);

	//housingInfoEntry(6,MENU_DICT.ENUID,MENU_DICT.SELECTMRCB,MENU_DICT.SELECTPSU,MENU_DICT.SELECTSSU,MENU_DICT.SELECTHH);	
endif;

{if $ = -1 then //Back to main menu
 errmsg("not coded yet : select module and continue");
 reenter;
endif;}

if SELECTMODULE = 8 then
skip to COMPLETEMCODE;
endif;

{if SELECTMODULE = 0 then //FunctionmCompReport();
errmsg(" to be developed");
reenter;
endif;}



//module completeness
/////////////////////////////////////////////////////////////////////////////////////////////////////

if SELECTMODULE = 9 then

compModRep.clear();

hasfileMcHIES = 0;
hasfileMcDIS = 0;
hasfileMcFOODINS = 0;
hasfileMcFS =0;
hasfileMcNFp1=0;
hasfileMcNFp2 =0;
hasfileMcHI  =0;
 
 string hasHIESfile = maketext("..\checking\%06s\HIES_%06s%06d%03d.csdb",editorUserId,MODULEMENU_DICT.ENUID,MODULEMENU_DICT.A0_MRCB,MODULEMENU_DICT.PSU);	
 if fileexist(hasHIESfile) > 0	then //1
 hasfileMcHIES = 1;
 //else 
 endif;
	setfile(HIESANDCHILDDIC_DICT,hasHIESfile);
	
    forcase HIESANDCHILDDIC_DICT where 
        HIESANDCHILDDIC_DICT.MODULENO = 1 and
        HIESANDCHILDDIC_DICT.ENUID = MODULEMENU_DICT.ENUID and
        HIESANDCHILDDIC_DICT.A0_MRCB = MODULEMENU_DICT.A0_MRCB and
        HIESANDCHILDDIC_DICT.PSU = MODULEMENU_DICT.PSU and
        HIESANDCHILDDIC_DICT.SSU = MODULEMENU_DICT.SSU and
        HIESANDCHILDDIC_DICT.HH = MODULEMENU_DICT.HH do
		
		hasfileMcHIES = hasfileMcHIES + 1;

        // Check module completeness
		
        if HIESANDCHILDDIC_DICT.COMPLETE_HCMOD = 1 then
		
            // If complete, add to the report
            compModRep.add(modName1 + "-" +status1);//complete
        else
            // If incomplete 
            compModRep.add(modName1 + "-" +status2);//partially 
        endif;
    endfor;
	if hasfileMcHIES = 1 then 
	//errmsg(" if hasfile =4 then %v",hasfileMcHIES);
		compModRep.add(modName1 + "-" +status3);//not yet started
		endif;
		savepartial();
/////////////////////////////////////////////////////////////////////////////////

string hasDisasterfile = maketext("..\checking\%06s\DISASTER_%06s%06d%03d.csdb",editorUserId,MODULEMENU_DICT.ENUID,MODULEMENU_DICT.A0_MRCB,MODULEMENU_DICT.PSU);	
 if fileexist(hasDisasterfile) > 0	then 
 hasfileMcDIS = 1;
 endif;
   
setfile(DISASTERMODDIC_DICT,hasDisasterfile);	

forcase DISASTERMODDIC_DICT where DISASTERMODDIC_DICT.MODULENO = 2 and 
   DISASTERMODDIC_DICT.ENUID=MODULEMENU_DICT.ENUID and 
   DISASTERMODDIC_DICT.A0_MRCB=MODULEMENU_DICT.A0_MRCB and 
   DISASTERMODDIC_DICT.PSU=MODULEMENU_DICT.PSU and 
   DISASTERMODDIC_DICT.SSU=MODULEMENU_DICT.SSU and 
   DISASTERMODDIC_DICT.HH = MODULEMENU_DICT.HH do

   hasfileMcDIS = hasfileMcDIS + 1;
   
        // Check module completeness
        if DISASTERMODDIC_DICT.COMP_DISASTERMOD = 1 then
            // If complete, add to the report
           compModRep.add(modName2 + "-" +status1);
        else
            // If incomplete 
          compModRep.add(modName2 + "-" +status2);
        endif;
    endfor;
	if hasfileMcDIS = 1 then 
		compModRep.add(modName2 + "-" +status3);
		endif;
	savepartial();
////////////////////foodinsecurity ///////////////////////////////////////////////////	
string hasFoodInsFile = maketext("..\checking\%06s\FOODSECURITY_%06s%06d%03d.csdb",editorUserId,MODULEMENU_DICT.ENUID,MODULEMENU_DICT.A0_MRCB,MODULEMENU_DICT.PSU);	
 if fileexist(hasFoodInsFile) > 0	then
 hasfileMcFOODINS = 1;
 setfile(FOODINSMODDIC_DICT,hasFoodInsFile);
else
compModRep.add(modName3 + "-" +status3); 
 endif;
   
//setfile(FOODINSMODDIC_DICT,hasFoodInsFile);	

forcase FOODINSMODDIC_DICT where FOODINSMODDIC_DICT.MODULENO = 3 and 
   FOODINSMODDIC_DICT.ENUID=MODULEMENU_DICT.ENUID and 
   FOODINSMODDIC_DICT.A0_MRCB=MODULEMENU_DICT.A0_MRCB and 
   FOODINSMODDIC_DICT.PSU=MODULEMENU_DICT.PSU and 
   FOODINSMODDIC_DICT.SSU=MODULEMENU_DICT.SSU and 
   FOODINSMODDIC_DICT.HH = MODULEMENU_DICT.HH do  

   hasfileMcFOODINS = hasfileMcFOODINS + 1;
      
        // Check module completeness
        if FOODINSMODDIC_DICT.COMP_FOODSECMOD = 1 then
            // If complete, add to the report
            compModRep.add(modName3 + "-" +status1);
        else
            // If incomplete 
            compModRep.add(modName3 + "-" +status2);
        endif;
    endfor;	
	if hasfileMcFOODINS = 1 then 
		compModRep.add(modName3 + "-" +status3);
		endif;
	savepartial();
////////Food Sheet/////////////////////////////////	
string hasFoodSheetFile = maketext("..\checking\%06s\FOODSHEET_%06s%06d%03d.csdb",editorUserId,MODULEMENU_DICT.ENUID,MODULEMENU_DICT.A0_MRCB,MODULEMENU_DICT.PSU);	
		if fileexist(hasFoodSheetFile) > 0	then  
		 hasfileMcFS = 1;
		 setfile(FOODSHEETDIC_DICT,hasFoodSheetFile);
		 else
		 compModRep.add(modName4 + "-" +status3);
		 endif;
		 
 //setfile(FOODSHEETDIC_DICT,hasFoodSheetFile);
// Loop 
forcase FOODSHEETDIC_DICT where FOODSHEETDIC_DICT.MODULENO = 4 and 
   FOODSHEETDIC_DICT.ENUID=MODULEMENU_DICT.ENUID and 
   FOODSHEETDIC_DICT.A0_MRCB=MODULEMENU_DICT.A0_MRCB and 
   FOODSHEETDIC_DICT.PSU=MODULEMENU_DICT.PSU and 
   FOODSHEETDIC_DICT.SSU=MODULEMENU_DICT.SSU and 
   FOODSHEETDIC_DICT.HH = MODULEMENU_DICT.HH do

    hasfileMcFS = hasfileMcFS + 1;    
		
		// Check module completeness
        if FOODSHEETDIC_DICT.COMP_FSHEETMOD = 1 then
            // If complete, add to the report
            compModRep.add(modName4 + "-" +status1);
        else
            // If incomplete 
            compModRep.add(modName4 + "-" +status2);
	endif;		
    endfor;	
	if hasfileMcFS = 1 then 
		compModRep.add(modName4 + "-" +status3);
		endif;
		savepartial();
