		//filewrite(ModuleReports1,"<td>%3d</td>");
	endfor;	
		
		filewrite(HousingInfoRep,"</table>");	
		filewrite(HousingInfoRep,"</body>");
		filewrite(HousingInfoRep,"</html>");
		
       close(HousingInfoRep);
		
		if getos() in 20:29 then // Android 
		
		string HousingInfoRepHtml ="html:file://" + pathconcat(Application, "./reports/HousingInfoRep.html");
		execsystem(HousingInfoRepHtml);
		else //Windows 
			view("./reports/HousingInfoRep.html", title := "HousingInfo Module Report", 
			width := 400, height := 600, showCloseButton := true);
			endif;	
		end;	
				



