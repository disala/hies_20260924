viewHiesandChildReport(MODULEMENU_DICT.ENUID,MODULEMENU_DICT.A0_MRCB,MODULEMENU_DICT.PSU,MODULEMENU_DICT.SSU,MODULEMENU_DICT.HH);
reenter SUMMARYREP;
endif;

