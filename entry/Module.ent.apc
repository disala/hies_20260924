// Loop 
forcase HOUSINGINFODIC_DICT where HOUSINGINFODIC_DICT.MODULENO = 7 and 
   HOUSINGINFODIC_DICT.ENUID=MODULEMENU_DICT.ENUID and 
   HOUSINGINFODIC_DICT.A0_MRCB=MODULEMENU_DICT.A0_MRCB and 
