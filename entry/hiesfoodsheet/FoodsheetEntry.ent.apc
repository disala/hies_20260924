end;


function OnChangeLanguage()
 savesetting("curLanguage",getlanguage());
end;

//----------------------------done by Mr.Dhammika----------------------------
function numeric datecalculation(numeric D1y,D1m,D1d, i);
    if D1m in 1,3,5,7,8,10,12 then
        if D1d+i<32 then
            D1d=D1d+i;
        else
            D1d=d1d-31;
            if not d1m =12 then d1m=d1m+1; else d1m = 1; D1y=D1y+1; endif;
        endif;
    endif;
    if D1m in 4,6,9,11 then
        if D1d+i<31 then
            D1d=D1d+i;
        else
            D1d=d1d-30;
            d1m=d1m+1; 
        endif;
    endif;
    if D1m =2 then
        if D1d+i<29then
            D1d=D1d+i;
        else
            D1d=d1d-28;
            d1m=d1m+1; 
        endif;
    endif;
    datecalculation=(d1y*10000)+(d1m*100)+d1d;
end;



