//saveids

function saveIdsForLogin()  
	savesetting("MODULENO",FOODSHEETDIC_DICT.MODULENO);
	savesetting("ENUID",strip(FOODSHEETDIC_DICT.ENUID));
	savesetting("A0_MRCB",FOODSHEETDIC_DICT.A0_MRCB);
	savesetting("PSU",FOODSHEETDIC_DICT.PSU);
	savesetting("SSU",FOODSHEETDIC_DICT.SSU);
	savesetting("HH",FOODSHEETDIC_DICT.HH);
	savesetting("endx",1);
end;

function goto()
    numeric section = accept("Go to?",
                             "Section 1-  Weekly Consumption",
                             "Section 2 - Day 1",
							 "Section 3 - Day 2",
                             "Section 4 - Day 3",
							 "Section 5 - Day 4",
							 "Section 6 - Day 5",
							 "Section 7 - Day 6",
							 "Section 8 - Day 7");						 
						
    if section = 1 then
	move to SECTION_4_FOOD advance;
    elseif section = 2 then
        move to  D1YYYY advance;
    elseif section = 3 then
        move to  D2DATE advance;
	elseif section = 4 then
        move to  D3DATE advance;
	elseif section = 5 then
		move to  D4DATE advance;	
	elseif section = 6 then
		move to  D5DATE advance;
	elseif section = 7 then
		move to  D6DATE advance;
	elseif section = 8 then
		move to  D7DATE advance;	
	 endif;	
end;


function onstop()
	savepartial();
	saveIdsForLogin();
end;


function backtomain()
	if accept(maketext(100),maketext(10),maketext(20))=1 then
		//advance to MENU_DICT.MAINMENU;
		//errmsg("err in hiesbackto main");
		execpff("HIES2025.pff", stop);
endif;
end;

{function backtomain()
	if accept(maketext(101),maketext(10),maketext(20))=1 then
	//errmsg("err in hiesexitprogram");
		stop(1);
	endif;
end;}


function showMenu()
	userbar(clear);
	//userbar(add Button,maketext(22),exitprogram());
	//userbar(add Button,maketext(22),backtomain());
	userbar(add Button,maketext(1001),goto());
	userbar(show);
end;


