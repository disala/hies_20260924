	D1unit6=1;
endif;
PROC VALUE6
codetextvalue =concat( codetextvalue," , ", getvaluelabel(CODE6));
if D7SDATE < 1 then D7SDATE= sysdate("DDMMYYYY"); endif;
if  $ < 1 then 
	errmsg("Reenter , Value > 0");
	reenter;
endif;
PROC INKIND_VALUE6
if $ > value6 then errmsg("Re enter INKIND VALUE(Value( %d)  > or  = Inkind Value( %d))",value6,$); reenter; endif;
if totocc(SEC_4_1_FOOD_EXP_D7000)< d7noi then
    skip next;
else
//
    //skip next;
endif;

savepartial();

PROC D4_7_ADD
savepartial();
//if $=2 then d1noi=int(d1noi)+1; endif;
//if $=1 then errmsg("no error"); endif;
if $=2 then  if FOODSE <> 12 then FOODSE = FOODSE+1; else endgroup; endif; endif;
if $=3 then endgroup; endif;
if $=4 then 
	
	numeric noi= accept("Select Food Category","1.    Cereals",
	"2.   Foods prepared outside", "3.    Pulses","4.    Vegetables and leaves", "4.1 --  Leafy Vegetables",
	"5.    Yams and other similar foods","6.     Meat","7.     Fish (fresh)","8.    Dried fish",
	"9.    Eggs","10.    Coconuts (nuts / powder/liquid) ","16.     Fruits (fresh and dried)",
	"17.    Confectioneries and other short eats","Go to next day");
	
	if noi=14 then endgroup; else FOODSE = noi; endif;
endif;
PROC SAVESTATUS_FSHEETMOD		
if SAVESTATUS_FSHEETMOD = 1 then 
savepartial();
errmsg("Successfully Saved  the FoodSheet for this MRCB -%6d,PSU- %3d,SSU -%2d,HH - %1d household.",A0_MRCB,PSU,SSU,HH);
skip to COMP_FSHEETMOD;
else if SAVESTATUS_FSHEETMOD = 2 then 
 savepartial();
 saveIdsForLogin();  
 else if $ = 3 then 
 saveIdsForLogin();  
   //go to the main menu
 else
 
 
list string respondent_query; 
numeric counter;
respondent_query.add("Weekly Consumption ");
do varying counter = 1 until counter > totocc(SEC_4_1_FOOD_EXP_WEEKLY000)
    
	respondent_query.add(maketext(getvaluelabel(CODE7(counter))+ " - Value = " + edit("9999999",VALUE7(counter)))); 	
enddo;
//day 1
respondent_query.add("Day 1 Consumption");
do varying counter = 1 until counter > totocc(SEC_4_1_FOOD_EXP_D1000)
    
	respondent_query.add(maketext(getvaluelabel(CODE(counter))+ " - Value = " + edit("9999999",value(counter)))); 	
enddo;
//4222
//day 2
respondent_query.add("Day 2 Consumption");
do varying counter = 1 until counter > totocc(SEC_4_1_FOOD_EXP_D2000)
    
	respondent_query.add(maketext(getvaluelabel(CODE1(counter))+ " - Value = " + edit("9999999",value1(counter)))); 	
enddo;
//day 3
respondent_query.add("Day 3 Consumption");
do varying counter = 1 until counter > totocc(SEC_4_1_FOOD_EXP_D3000)
    
	respondent_query.add(maketext(getvaluelabel(CODE2(counter))+ " - Value = " + edit("9999999",value2(counter)))); 	
enddo;
//day 4
respondent_query.add("Day 4 Consumption");
do varying counter = 1 until counter > totocc(SEC_4_1_FOOD_EXP_D4000)
    
	respondent_query.add(maketext(getvaluelabel(CODE3(counter))+ " - Value = " + edit("9999999",value3(counter)))); 	
enddo;
//day 5
respondent_query.add("Day 5 Consumption");
do varying counter = 1 until counter > totocc(SEC_4_1_FOOD_EXP_D5000)
    
	respondent_query.add(maketext(getvaluelabel(CODE4(counter))+ " - Value = " + edit("9999999",value4(counter)))); 	
enddo;
//day 6
respondent_query.add("Day 6 Consumption");
do varying counter = 1 until counter > totocc(SEC_4_1_FOOD_EXP_D6000)
    
	respondent_query.add(maketext(getvaluelabel(CODE5(counter))+ " - Value = " + edit("9999999",value5(counter)))); 	
enddo;
//day 7
respondent_query.add("Day 7 Consumption");
do varying counter = 1 until counter > totocc(SEC_4_1_FOOD_EXP_D7000)
    
	respondent_query.add(maketext(getvaluelabel(CODE6(counter))+ " - Value = " + edit("9999999",value6(counter)))); 	
enddo;
numeric respondent_index = respondent_query.show("Items of FoodSheet");
   
  reenter;
  endif;
  endif;
  endif;
  
 
 

  
PROC COMP_FSHEETMOD
preproc 
ask if SAVESTATUS_FSHEETMOD =1;
if SAVESTATUS_FSHEETMOD =1 then 
COMP_FSHEETMOD =1;
endif;
postproc
if COMP_FSHEETMOD = 1 then 
file ModuleCompleteness; 
setfile(ModuleCompleteness,"../reports/CompleteModule/ModuleCompleteness.txt", update);

//ModuleCompleteness.write("%8d,%6d,%3d,%2d,%2d,%v,%v",sysdate("YYYYMMDD"),A0_MRCB,PSU,SSU,HH,getlabel(MODULENO_VS2,MODULENO),getlabel(COMPLETE_HCMOD_VS1,COMPLETE_HCMOD)); 
ModuleCompleteness.close();filewrite(ModuleCompleteness,"%6d,%3d,%2d,%2d,%1d,%1d",A0_MRCB,PSU,SSU,HH,MODULENO,COMP_FSHEETMOD);	
saveIdsForLogin();  
endif;
