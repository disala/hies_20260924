//chat gpt
{preproc
    numeric i;
    // Check if there are any existing entries in SEC_4_1_FOOD_EXP_D1000
    if totocc(SEC_4_1_FOOD_EXP_D1000) > 0 then
        // Display the total number of existing entries
        errmsg("Total occurrences: %d", totocc(SEC_4_1_FOOD_EXP_D1000));
        
        // Prompt the user for action
        numeric day_choice = accept("Already entered. Do you select?", 
                                    "Add new item", 
                                    "Select existing item", 
                                    "Move to next day");

        if day_choice = 1 then
            // If user chooses to add a new item, skip to the next entry position
            skip to code(totocc(SEC_4_1_FOOD_EXP_D1000) + 1);
        elseif day_choice = 2 then
            // Prepare a string to display the existing items
            string k = "";
            do varying i = 1 until i > totocc(SEC_4_1_FOOD_EXP_D1000)
                // Debug messages for verification
                errmsg("Code index %v", i);
                errmsg("Code value label %s", getvaluelabel(code(i)));
                errmsg("Code number %v", code(i));
                errmsg("Visual value %v", visualvalue(code(i)));
                
                // Append the visual value to the string k
                if i = 1 then
                    k = maketext('"%v"', visualvalue(code(i)));
                else
                    k = maketext(k + ', "%v"', visualvalue(code(i)));
                endif;

                errmsg("Current string value: %s", k);
            enddo;
            
            errmsg("Final string value is: %s", k);

            // Prompt the user to select an item or end
            numeric j = accept("Select item", k, "End");
            
            // Skip to the selected item or end
            if j > 0 then
                skip to code(j);
            else
                // Handle case when the user selects "End"
                move to SECTION_4_FOOD;
            endif;
        else
            // If user chooses to move to the next day, navigate to the appropriate section
            move to SECTION_4_FOOD;
        endif;
    endif;
}
